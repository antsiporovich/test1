@model List<PropertyManagement.Web.Models.AvailableUnitRowViewModel>
@{
    ViewData["Title"] = "Browse Units";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8">

        <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
            <div>
                <h1 class="text-3xl font-extrabold text-ink mb-1">Available Units</h1>
                <p class="text-sm text-muted">Browse available apartments and find the perfect place to call home.</p>
            </div>
            <div class="flex items-center gap-3">
                <div class="relative">
                    <i data-lucide="search" class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
                    <input type="text" id="unitSearchInput" placeholder="Search by property, city, or unit number..."
                           class="w-full sm:w-80 pl-9 pr-3.5 py-2 border border-gray-300 rounded-md text-sm text-gray-700 bg-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors" />
                </div>
                <button type="button" id="unitSearchBtn" class="inline-flex items-center gap-2 px-4 py-2 border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-md bg-white transition-colors">
                    <i data-lucide="sliders-horizontal" class="w-4 h-4"></i>
                    Filter
                </button>
            </div>
        </div>

        @if (TempData["Error"] is string error)
        {
            <div class="mb-5 flex items-center gap-3 px-4 py-3 bg-amber-50 border border-amber-200 text-amber-800 rounded-xl text-sm" role="alert">
                @error
            </div>
        }

        @if (Model.Count == 0)
        {
            <p class="text-sm text-gray-400">No units are currently available.</p>
        }
        else
        {
            <div class="border border-gray-200 rounded-xl overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-xs" id="unitsTable">
                        <thead>
                            <tr class="bg-gray-50 border-y border-gray-200">
                                <th class="text-left px-6 py-3 text-xs font-semibold text-gray-500">Property</th>
                                <th class="text-left px-6 py-3 text-xs font-semibold text-gray-500 select-none">
                                    <button type="button" class="sort-btn inline-flex items-center gap-1 hover:text-gray-800" data-sort="unit">
                                        Unit # <i data-lucide="chevrons-up-down" class="w-3.5 h-3.5 text-gray-400 sort-icon"></i>
                                    </button>
                                </th>
                                <th class="text-left px-6 py-3 text-xs font-semibold text-gray-500 select-none">
                                    <button type="button" class="sort-btn inline-flex items-center gap-1 hover:text-gray-800" data-sort="bedrooms">
                                        Bedrooms <i data-lucide="chevrons-up-down" class="w-3.5 h-3.5 text-gray-400 sort-icon"></i>
                                    </button>
                                </th>
                                <th class="text-left px-6 py-3 text-xs font-semibold text-gray-500 select-none">
                                    <button type="button" class="sort-btn inline-flex items-center gap-1 hover:text-gray-800" data-sort="rent">
                                        Rent <i data-lucide="chevrons-up-down" class="w-3.5 h-3.5 text-gray-400 sort-icon"></i>
                                    </button>
                                </th>
                                <th class="text-left px-6 py-3 text-xs font-semibold text-gray-500 select-none">
                                    <button type="button" class="sort-btn inline-flex items-center gap-1 hover:text-gray-800" data-sort="type">
                                        Type <i data-lucide="chevrons-up-down" class="w-3.5 h-3.5 text-gray-400 sort-icon"></i>
                                    </button>
                                </th>
                                <th class="text-right px-6 py-3 text-xs font-semibold text-gray-500">Action</th>
                            </tr>
                        </thead>
                        <tbody id="unitTableBody">
                            @foreach (var unit in Model)
                            {
                                <tr class="border-b border-gray-100 last:border-0 hover:bg-gray-50/70 transition-colors"
                                    data-search-text="@($"{unit.PropertyName} {unit.PropertyAddress} {unit.UnitNumber} {unit.UnitTypeName}".ToLowerInvariant())"
                                    data-unit="@unit.UnitNumber" data-bedrooms="@unit.Bedrooms" data-rent="@unit.MonthlyRent" data-type="@unit.UnitTypeName">
                                    <td class="px-6 py-2.5">
                                        <div class="flex items-center gap-3">
                                            <img src="@PropertyImageUrls.UnitImage(unit.PropertyName)" alt="@unit.PropertyName" class="w-14 h-10 rounded-md object-cover flex-shrink-0 bg-gray-100" />
                                            <div>
                                                <p class="text-gray-900 font-semibold text-sm">@unit.PropertyName</p>
                                                <p class="text-[11px] text-gray-400 mt-0.5">@unit.PropertyAddress</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-2.5 text-gray-700">@unit.UnitNumber</td>
                                    <td class="px-6 py-2.5 text-gray-700">@unit.Bedrooms</td>
                                    <td class="px-6 py-2.5 text-gray-700">@unit.MonthlyRent.ToString("C0") / month</td>
                                    <td class="px-6 py-2.5 text-gray-700">@unit.UnitTypeName</td>
                                    <td class="px-6 py-2.5 text-right">
                                        <form asp-controller="Browse" asp-action="Apply" asp-route-unitId="@unit.UnitId" method="post" class="inline">
                                            <button type="submit" class="inline-flex items-center justify-center w-[75px] py-1.5 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-md transition-colors">Apply</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <p class="text-xs text-muted mt-4" id="unitCountSummary">Showing @Model.Count available unit@(Model.Count == 1 ? "" : "s")</p>
        }

    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('unitSearchInput');
            var btn = document.getElementById('unitSearchBtn');
            var tbody = document.getElementById('unitTableBody');
            var summary = document.getElementById('unitCountSummary');
            if (!tbody) return;

            var rows = Array.from(tbody.querySelectorAll('tr'));
            var total = rows.length;
            var sortState = { key: null, dir: 1 };

            function filter() {
                if (!input) return;
                var term = input.value.trim().toLowerCase();
                var visible = 0;
                rows.forEach(function (row) {
                    var match = row.dataset.searchText.indexOf(term) !== -1;
                    row.classList.toggle('hidden', !match);
                    if (match) visible++;
                });
                if (summary) {
                    summary.textContent = 'Showing ' + visible + ' available unit' + (visible === 1 ? '' : 's');
                }
            }

            function compareRows(a, b, key, dir) {
                if (key === 'bedrooms' || key === 'rent') {
                    return (Number(a.dataset[key]) - Number(b.dataset[key])) * dir;
                }
                if (key === 'unit') {
                    return a.dataset.unit.localeCompare(b.dataset.unit, undefined, { numeric: true, sensitivity: 'base' }) * dir;
                }
                return (a.dataset[key] || '').localeCompare(b.dataset[key] || '') * dir;
            }

            document.querySelectorAll('.sort-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var key = btn.dataset.sort;
                    sortState.dir = (sortState.key === key) ? -sortState.dir : 1;
                    sortState.key = key;
                    rows.sort(function (a, b) { return compareRows(a, b, key, sortState.dir); });
                    rows.forEach(function (row) { tbody.appendChild(row); });
                    document.querySelectorAll('.sort-icon').forEach(function (icon) {
                        icon.setAttribute('data-lucide', 'chevrons-up-down');
                        icon.classList.remove('text-brand-600');
                        icon.classList.add('text-gray-400');
                    });
                    var activeIcon = btn.querySelector('.sort-icon');
                    if (activeIcon) {
                        activeIcon.setAttribute('data-lucide', sortState.dir === 1 ? 'chevron-up' : 'chevron-down');
                        activeIcon.classList.remove('text-gray-400');
                        activeIcon.classList.add('text-brand-600');
                    }
                    if (window.lucide) lucide.createIcons();
                });
            });

            if (input) input.addEventListener('input', filter);
            if (btn) btn.addEventListener('click', filter);
        })();
    </script>
}
