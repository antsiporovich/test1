@model List<PropertyManagement.Web.Models.AvailableUnitRowViewModel>
@{
    ViewData["Title"] = "Browse Units";
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <h1 class="text-2xl font-bold text-gray-900 mb-1">Available Rental Units</h1>
    <p class="text-sm text-gray-500 mb-6">Find your next home. Browse available units and submit an application.</p>

    @if (TempData["Error"] is string error)
    {
        <div class="mb-5 flex items-center gap-3 px-4 py-3 bg-amber-50 border border-amber-200 text-amber-800 rounded-xl text-sm" role="alert">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            @error
        </div>
    }

    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">

        @* Client-side search over the already-rendered rows — no server round-trip for this small, unpaginated list. *@
        <div class="px-6 py-4">
            <div class="flex gap-2">
                <input type="text" id="unitSearchInput" placeholder="Search by property, city, or unit number…"
                       class="flex-1 px-3.5 py-2 border border-gray-300 rounded-md text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors" />
                <button type="button" id="unitSearchBtn" class="px-4 bg-brand-600 hover:bg-brand-700 text-white rounded-md flex items-center justify-center transition-colors" aria-label="Search">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                </button>
            </div>
        </div>

        @if (Model.Count == 0)
        {
            <p class="px-6 pb-6 text-sm text-gray-400">No units are currently available.</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-xs">
                    <thead>
                        <tr class="bg-gray-50 border-y border-gray-200">
                            <th class="text-left px-6 py-2 text-xs font-semibold text-gray-500">Property</th>
                            <th class="text-left px-6 py-2 text-xs font-semibold text-gray-500">Unit #</th>
                            <th class="text-left px-6 py-2 text-xs font-semibold text-gray-500">Bedrooms</th>
                            <th class="text-left px-6 py-2 text-xs font-semibold text-gray-500">Rent</th>
                            <th class="text-left px-6 py-2 text-xs font-semibold text-gray-500">Type</th>
                            <th class="text-right px-6 py-2 text-xs font-semibold text-gray-500">Action</th>
                        </tr>
                    </thead>
                    <tbody id="unitTableBody">
                        @foreach (var unit in Model)
                        {
                            <tr class="border-b border-gray-100 last:border-0 hover:bg-gray-50/70 transition-colors" data-search-text="@($"{unit.PropertyName} {unit.UnitNumber} {unit.UnitTypeName}".ToLowerInvariant())">
                                <td class="px-6 py-2.5 text-gray-900 font-medium">@unit.PropertyName</td>
                                <td class="px-6 py-2.5 text-gray-700">@unit.UnitNumber</td>
                                <td class="px-6 py-2.5 text-gray-700">@unit.Bedrooms</td>
                                <td class="px-6 py-2.5 text-gray-700">@unit.MonthlyRent.ToString("C0")</td>
                                <td class="px-6 py-2.5 text-gray-700">@unit.UnitTypeName</td>
                                <td class="px-6 py-2.5 text-right">
                                    <form asp-controller="Browse" asp-action="Apply" asp-route-unitId="@unit.UnitId" method="post" class="inline">
                                        <button type="submit" class="px-4 py-1.5 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-md transition-colors">Apply</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="px-6 py-3.5 border-t border-gray-200 text-xs text-gray-500" id="unitCountSummary">
                Showing @Model.Count of @Model.Count unit@(Model.Count == 1 ? "" : "s")
            </div>
        }
    </div>

</div>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('unitSearchInput');
            var btn = document.getElementById('unitSearchBtn');
            var rows = Array.from(document.querySelectorAll('#unitTableBody tr'));
            var summary = document.getElementById('unitCountSummary');
            var total = rows.length;
            if (!input) return;

            function filter() {
                var term = input.value.trim().toLowerCase();
                var visible = 0;
                rows.forEach(function (row) {
                    var match = row.dataset.searchText.indexOf(term) !== -1;
                    row.classList.toggle('hidden', !match);
                    if (match) visible++;
                });
                if (summary) {
                    summary.textContent = 'Showing ' + visible + ' of ' + total + (total === 1 ? ' unit' : ' units');
                }
            }

            input.addEventListener('input', filter);
            if (btn) { btn.addEventListener('click', filter); }
        })();
    </script>
}
