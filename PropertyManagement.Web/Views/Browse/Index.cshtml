@model List<PropertyManagement.Web.Models.AvailableUnitRowViewModel>
@{
    ViewData["Title"] = "Browse Units";
}

<h1>Available Units</h1>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}

@if (Model.Count == 0)
{
    <p class="text-muted">No units are currently available.</p>
}
else
{
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>Property</th>
                <th>Unit #</th>
                <th>Bedrooms</th>
                <th>Rent</th>
                <th>Type</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var unit in Model)
            {
                <tr>
                    <td>@unit.PropertyName</td>
                    <td>@unit.UnitNumber</td>
                    <td>@unit.Bedrooms</td>
                    <td>@unit.MonthlyRent.ToString("C")</td>
                    <td>@unit.UnitTypeName</td>
                    <td class="text-end">
                        <form asp-controller="Browse" asp-action="Apply" asp-route-unitId="@unit.UnitId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-primary">Apply</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
