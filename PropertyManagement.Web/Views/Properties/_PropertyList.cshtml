@model List<PropertyManagement.Web.Models.PropertyRowViewModel>
@{
    // Deterministic placeholder photos (no image data in the model — picked by property id).
    // House / building EXTERIORS only.
    string[] photos =
    {
        "https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=160&h=160&fit=crop&q=80",
        "https://images.unsplash.com/photo-1570129477492-45c003edd2be?w=160&h=160&fit=crop&q=80",
        "https://images.unsplash.com/photo-1449844908441-8829872d2607?w=160&h=160&fit=crop&q=80",
        "https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=160&h=160&fit=crop&q=80",
        "https://images.unsplash.com/photo-1580587771525-78b9dba3b914?w=160&h=160&fit=crop&q=80",
    };
}

@if (Model.Count == 0)
{
    <div class="bg-white border border-gray-200 rounded-xl p-10 text-center">
        <p class="text-sm text-gray-400">No properties yet. Add one to get started.</p>
    </div>
}

@foreach (var property in Model)
{
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <div class="flex items-center justify-between px-6 py-3.5 border-b border-gray-200">
            <div class="flex items-center gap-3 min-w-0">
                <img src="@photos[property.Id % photos.Length]" alt="@property.Name"
                     class="w-12 h-12 rounded-lg object-cover shrink-0 bg-gray-100" />
                <div class="min-w-0">
                    <h2 class="text-[15px] font-bold text-gray-900 truncate">@property.Name</h2>
                    <p class="text-xs text-gray-400 flex items-center gap-1 mt-0.5">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                        <span class="truncate">@property.Address</span>
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
                <button type="button" class="inline-flex items-center px-3.5 py-1.5 text-xs font-medium border border-gray-300 rounded-md text-gray-600 hover:bg-gray-50 transition-colors"
                        data-ajax-modal-url="@Url.Action("EditForm", new { id = property.Id })"
                        data-refresh-url="@Url.Action("ListPartial")"
                        data-refresh-target="#propertyListRegion">
                    Edit
                </button>
                <button type="button" class="inline-flex items-center px-3.5 py-1.5 text-xs font-medium border border-gray-300 rounded-md text-red-600 hover:bg-red-50 transition-colors"
                        data-ajax-remove-url="@Url.Action("Remove", new { id = property.Id })"
                        data-confirm="Remove @property.Name? Its units will no longer be listed."
                        data-refresh-url="@Url.Action("ListPartial")"
                        data-refresh-target="#propertyListRegion">
                    Remove
                </button>
            </div>
        </div>

        <div class="flex items-center justify-between px-6 pt-3.5 pb-2.5">
            <span class="text-sm font-semibold text-gray-700">Units (@property.UnitCount)</span>
            <button type="button" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-md transition-colors"
                    data-ajax-modal-url="@Url.Action("CreateForm", "Units", new { propertyId = property.Id })"
                    data-refresh-url="@Url.Action("UnitsPartial", "Units", new { propertyId = property.Id })"
                    data-refresh-target="#unitListRegion-@property.Id">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                Add Unit
            </button>
        </div>

        <div id="unitListRegion-@property.Id">
            @await Component.InvokeAsync("UnitList", new { propertyId = property.Id })
        </div>
    </div>
}
