@model List<PropertyManagement.Web.Models.PropertyRowViewModel>

@if (Model.Count == 0)
{
    <p class="text-muted">No properties yet. Add one to get started.</p>
}

@foreach (var property in Model)
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <strong>@property.Name</strong>
                <div class="text-muted small">@property.Address</div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge text-bg-secondary">@property.UnitCount unit@(property.UnitCount == 1 ? "" : "s")</span>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        data-ajax-modal-url="@Url.Action("EditForm", new { id = property.Id })"
                        data-refresh-url="@Url.Action("ListPartial")"
                        data-refresh-target="#propertyListRegion">
                    Edit
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger"
                        data-ajax-remove-url="@Url.Action("Remove", new { id = property.Id })"
                        data-confirm="Remove @property.Name? Its units will no longer be listed."
                        data-refresh-url="@Url.Action("ListPartial")"
                        data-refresh-target="#propertyListRegion">
                    Remove
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-end mb-2">
                <button type="button" class="btn btn-sm btn-primary"
                        data-ajax-modal-url="@Url.Action("CreateForm", "Units", new { propertyId = property.Id })"
                        data-refresh-url="@Url.Action("UnitsPartial", "Units", new { propertyId = property.Id })"
                        data-refresh-target="#unitListRegion-@property.Id">
                    Add Unit
                </button>
            </div>
            <div id="unitListRegion-@property.Id">
                @await Component.InvokeAsync("UnitList", new { propertyId = property.Id })
            </div>
        </div>
    </div>
}
