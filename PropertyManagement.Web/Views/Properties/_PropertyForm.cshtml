@model PropertyManagement.Web.Models.PropertyFormViewModel
@{
    var isEdit = Model.Id != 0;
    var actionUrl = isEdit ? Url.Action("Edit", new { id = Model.Id }) : Url.Action("Create");
}

<div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
    <h5 class="text-base font-bold text-ink">@(isEdit ? "Edit Property" : "Add Property")</h5>
    <button type="button" class="text-gray-400 hover:text-gray-600 transition-colors -mr-1" data-bs-dismiss="modal" aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
</div>
<form method="post" action="@actionUrl">
    @Html.AntiForgeryToken()
    <div class="px-6 py-5 space-y-3.5">
        <div asp-validation-summary="ModelOnly" class="px-4 py-3 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm empty:hidden" role="alert"></div>
        <input type="hidden" asp-for="Id" />

        <div>
            <label asp-for="Name" class="block text-[13px] font-medium text-gray-700 mb-1.5">Property Name <span class="text-red-500">*</span></label>
            <input asp-for="Name" placeholder="Maple Grove Homes" class="w-full px-3.5 py-2 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors" />
            <span asp-validation-for="Name" class="text-xs text-red-500 mt-1 block"></span>
        </div>
        <div>
            <label asp-for="AddressLine1" class="block text-[13px] font-medium text-gray-700 mb-1.5">Address Line 1 <span class="text-red-500">*</span></label>
            <input asp-for="AddressLine1" placeholder="456 River Road" class="w-full px-3.5 py-2 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors" />
            <span asp-validation-for="AddressLine1" class="text-xs text-red-500 mt-1 block"></span>
        </div>
        <div>
            <label asp-for="AddressLine2" class="block text-[13px] font-medium text-gray-700 mb-1.5">Address Line 2</label>
            <input asp-for="AddressLine2" placeholder="Apt, Suite, Building (optional)" class="w-full px-3.5 py-2 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors" />
            <span asp-validation-for="AddressLine2" class="text-xs text-red-500 mt-1 block"></span>
        </div>
        <div class="grid grid-cols-3 gap-3">
            <div>
                <label asp-for="City" class="block text-[13px] font-medium text-gray-700 mb-1.5">City <span class="text-red-500">*</span></label>
                <input asp-for="City" placeholder="Springfield" class="w-full px-3.5 py-2 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors" />
                <span asp-validation-for="City" class="text-xs text-red-500 mt-1 block"></span>
            </div>
            <div>
                <label asp-for="State" class="block text-[13px] font-medium text-gray-700 mb-1.5">State <span class="text-red-500">*</span></label>
                <input asp-for="State" placeholder="IL" class="w-full px-3.5 py-2 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors" />
                <span asp-validation-for="State" class="text-xs text-red-500 mt-1 block"></span>
            </div>
            <div>
                <label asp-for="ZipCode" class="block text-[13px] font-medium text-gray-700 mb-1.5">ZIP Code <span class="text-red-500">*</span></label>
                <input asp-for="ZipCode" placeholder="62704" class="w-full px-3.5 py-2 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors" />
                <span asp-validation-for="ZipCode" class="text-xs text-red-500 mt-1 block"></span>
            </div>
        </div>
    </div>
    <div class="flex justify-end gap-3 px-6 py-4 border-t border-gray-200">
        <button type="button" class="px-4 py-2 border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-md transition-colors" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-md transition-colors">Save Property</button>
    </div>
</form>
