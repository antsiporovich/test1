@model PropertyManagement.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Create account";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create account — PropertyManagement</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50:  '#eef6f1',
                            100: '#d5e9dc',
                            200: '#aed3ba',
                            500: '#2b9e5f',
                            600: '#1e8a4f',
                            700: '#17703f',
                            800: '#135b34',
                            900: '#0e4527',
                        }
                    },
                    fontFamily: { sans: ['Inter','ui-sans-serif','system-ui','sans-serif'] }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
</head>
<body class="min-h-screen bg-gray-50 flex items-center justify-center px-4 py-12 font-sans antialiased">

    <div class="w-full max-w-md">
        <div class="bg-white border border-gray-200 rounded-xl shadow-md px-8 py-9">

            @* Brand *@
            <div class="flex flex-col items-center mb-7">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 mb-6 group">
                    <span class="w-9 h-9 rounded-lg bg-brand-600 group-hover:bg-brand-700 transition-colors flex items-center justify-center">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                            <polyline points="9 22 9 12 15 12 15 22"/>
                        </svg>
                    </span>
                    <span class="font-bold text-gray-900 text-base tracking-tight">PropertyManagement</span>
                </a>
                <h1 class="text-[1.5rem] font-bold text-gray-900 mb-1">Create Your Account</h1>
                <p class="text-sm text-gray-500 text-center">Join our platform to find or manage rental properties.</p>
            </div>

            <form asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>

                @* Server-side errors *@
                <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm empty:hidden" role="alert"></div>

                @* Email *@
                <div class="mb-3.5">
                    <label asp-for="Email" class="block text-[13px] font-medium text-gray-700 mb-1.5"></label>
                    <input asp-for="Email" type="email"
                           class="w-full px-3.5 py-2 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors"
                           placeholder="you@example.com"
                           autocomplete="username" />
                    <span asp-validation-for="Email" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                @* Password *@
                <div class="mb-3.5">
                    <label asp-for="Password" class="block text-[13px] font-medium text-gray-700 mb-1.5"></label>
                    <div class="relative">
                        <input asp-for="Password" type="password" id="pwd-register"
                               class="w-full px-3.5 py-2 pr-11 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors"
                               placeholder="Create a password"
                               autocomplete="new-password" />
                        <button type="button" onclick="togglePwd('pwd-register', this)"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition-colors"
                                aria-label="Toggle password visibility">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                @* Confirm Password *@
                <div class="mb-5">
                    <label asp-for="ConfirmPassword" class="block text-[13px] font-medium text-gray-700 mb-1.5"></label>
                    <div class="relative">
                        <input asp-for="ConfirmPassword" type="password" id="pwd-confirm"
                               class="w-full px-3.5 py-2 pr-11 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors"
                               placeholder="Confirm your password"
                               autocomplete="new-password" />
                        <button type="button" onclick="togglePwd('pwd-confirm', this)"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition-colors"
                                aria-label="Toggle confirm password visibility">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                @* Role selector *@
                <fieldset class="mb-5">
                    <legend class="block text-[13px] font-medium text-gray-700 mb-2.5">I am a</legend>
                    <div class="grid grid-cols-2 gap-3">

                        @* Applicant card *@
                        <div id="card-applicant"
                             onclick="selectRole(this)"
                             class="cursor-pointer border-2 border-brand-600 bg-brand-50 rounded-lg p-3.5 transition-all select-none"
                             data-role-card>
                            <div class="flex items-start gap-2.5">
                                <span class="mt-0.5 w-4 h-4 rounded-full border-2 border-brand-600 flex items-center justify-center flex-shrink-0">
                                    <span class="w-2 h-2 rounded-full bg-brand-600" data-role-dot></span>
                                </span>
                                <div>
                                    <input type="radio" asp-for="Role"
                                           value="@PropertyManagement.Web.Models.AccountRole.Applicant"
                                           id="roleApplicant" class="sr-only" checked />
                                    <p class="text-sm font-semibold text-gray-900 leading-tight">Applicant</p>
                                    <p class="text-xs text-gray-500 mt-0.5 leading-snug">I want to find and rent a property</p>
                                </div>
                            </div>
                        </div>

                        @* Property Manager card *@
                        <div id="card-pm"
                             onclick="selectRole(this)"
                             class="cursor-pointer border-2 border-gray-300 bg-white rounded-lg p-3.5 transition-all select-none"
                             data-role-card>
                            <div class="flex items-start gap-2.5">
                                <span class="mt-0.5 w-4 h-4 rounded-full border-2 border-gray-300 flex items-center justify-center flex-shrink-0">
                                    <span class="w-2 h-2 rounded-full bg-brand-600 hidden" data-role-dot></span>
                                </span>
                                <div>
                                    <input type="radio" asp-for="Role"
                                           value="@PropertyManagement.Web.Models.AccountRole.PropertyManager"
                                           id="rolePropertyManager" class="sr-only" />
                                    <p class="text-sm font-semibold text-gray-900 leading-tight">Property Manager</p>
                                    <p class="text-xs text-gray-500 mt-0.5 leading-snug">I manage properties and tenants</p>
                                </div>
                            </div>
                        </div>

                    </div>
                    <span asp-validation-for="Role" class="text-xs text-red-500 mt-1 block"></span>
                </fieldset>

                @* Submit *@
                <button type="submit"
                        class="w-full py-2.5 bg-brand-600 hover:bg-brand-700 active:bg-brand-800 text-white font-semibold rounded-md text-sm transition-colors">
                    Create Account
                </button>

            </form>

            @* Login link *@
            <p class="text-center text-sm text-gray-500 mt-6">
                Already have an account?&nbsp;
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]"
                   class="font-medium text-brand-600 hover:text-brand-700 transition-colors">
                    Sign in
                </a>
            </p>

        </div>
    </div>

    <script src="@Url.Content("~/lib/jquery/dist/jquery.min.js")"></script>
    <script src="@Url.Content("~/lib/jquery-validation/dist/jquery.validate.min.js")"></script>
    <script src="@Url.Content("~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js")"></script>
    <script>
        var eyeOn  = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>';
        var eyeOff = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/></svg>';

        function togglePwd(inputId, btn) {
            var input = document.getElementById(inputId);
            var show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            btn.innerHTML = show ? eyeOff : eyeOn;
        }

        function selectRole(clickedCard) {
            var cards = document.querySelectorAll('[data-role-card]');
            cards.forEach(function(card) {
                var isActive = card === clickedCard;
                var radio = card.querySelector('input[type="radio"]');
                var ring  = card.querySelector('span > span:first-child') || card.querySelector('.rounded-full');
                var dot   = card.querySelector('[data-role-dot]');

                radio.checked = isActive;

                if (isActive) {
                    card.classList.remove('border-gray-300', 'bg-white');
                    card.classList.add('border-brand-600', 'bg-brand-50');
                    card.querySelector('.rounded-full.border-2').classList.remove('border-gray-300');
                    card.querySelector('.rounded-full.border-2').classList.add('border-brand-600');
                } else {
                    card.classList.remove('border-brand-600', 'bg-brand-50');
                    card.classList.add('border-gray-300', 'bg-white');
                    card.querySelector('.rounded-full.border-2').classList.remove('border-brand-600');
                    card.querySelector('.rounded-full.border-2').classList.add('border-gray-300');
                }

                dot.classList.toggle('hidden', !isActive);
            });
        }
    </script>

</body>
</html>
