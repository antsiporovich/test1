@model PropertyManagement.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Create account";
    Layout = null;
    var applicantSelected = Model.Role is null or PropertyManagement.Web.Models.AccountRole.Applicant;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Account — HomePlace</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'] },
                    colors: {
                        brand: {
                            50:  '#edf8f3',
                            100: '#d7efe4',
                            200: '#afdfc9',
                            500: '#3b916a',
                            600: '#29664a',
                            700: '#20503a',
                            800: '#193e2d',
                            900: '#132f22',
                        },
                        ink:   '#0b1220',
                        muted: '#4e5867',
                        mist:  '#ecf1f4',
                    }
                }
            }
        };
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    <style>body{font-family:'Inter',ui-sans-serif,system-ui,sans-serif;}</style>
</head>
<body class="bg-mist text-ink min-h-screen relative overflow-x-hidden">

    <div class="pointer-events-none absolute -bottom-24 -left-24 w-96 h-96 rounded-full bg-brand-100 opacity-60 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-32 -right-16 w-[28rem] h-[28rem] rounded-full bg-brand-100 opacity-50 blur-3xl"></div>

    <header class="relative z-10 bg-white border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-8">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2">
                    <i data-lucide="home" class="w-7 h-7 text-brand-600" stroke-width="2.2"></i>
                    <span class="font-bold text-lg text-ink tracking-tight">HomePlace</span>
                </a>
                <nav class="hidden md:flex items-center gap-6">
                    <a asp-controller="Home" asp-action="Index" class="text-sm font-medium text-gray-700 hover:text-gray-900">Home</a>
                    <a asp-controller="Home" asp-action="Privacy" class="text-sm font-medium text-gray-500 hover:text-gray-800">Privacy</a>
                </nav>
            </div>
            <div class="flex items-center gap-3">
                <a asp-controller="Account" asp-action="Login" class="text-sm text-gray-600 font-medium">Login</a>
                <a asp-controller="Account" asp-action="Register" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-md transition-colors">Register</a>
            </div>
        </div>
    </header>

    <main class="relative z-10 flex items-center justify-center px-4 py-14">
        <div class="w-full max-w-lg bg-white border border-gray-200 rounded-2xl shadow-xl px-8 py-10">
            <div class="flex flex-col items-center text-center mb-7">
                <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-brand-50 mb-3">
                    <i data-lucide="home" class="w-6 h-6 text-brand-600" stroke-width="2.2"></i>
                </div>
                <p class="text-sm font-semibold text-ink mb-3">HomePlace</p>
                <h1 class="text-3xl font-extrabold text-ink mb-2">Create Your Account</h1>
                <p class="text-sm text-muted leading-relaxed">
                    Join our community and start your property journey today.
                </p>
            </div>

            <form asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate class="space-y-4">
                <div asp-validation-summary="ModelOnly" class="px-4 py-3 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm empty:hidden" role="alert"></div>

                <div class="relative">
                    <i data-lucide="mail" class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                    <input asp-for="Email" type="email" placeholder="Email address" autocomplete="username"
                           class="w-full pl-10 pr-3.5 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors" />
                    <span asp-validation-for="Email" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div class="relative">
                    <i data-lucide="lock" class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                    <input asp-for="Password" type="password" id="pwd-register" placeholder="Password" autocomplete="new-password"
                           class="w-full pl-10 pr-10 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors" />
                    <button type="button" data-toggle-pwd="pwd-register" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600" aria-label="Toggle password visibility">
                        <i data-lucide="eye-off" class="w-4 h-4"></i>
                    </button>
                    <span asp-validation-for="Password" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div class="relative">
                    <i data-lucide="lock" class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                    <input asp-for="ConfirmPassword" type="password" id="pwd-confirm" placeholder="Confirm password" autocomplete="new-password"
                           class="w-full pl-10 pr-10 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors" />
                    <button type="button" data-toggle-pwd="pwd-confirm" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600" aria-label="Toggle confirm password visibility">
                        <i data-lucide="eye-off" class="w-4 h-4"></i>
                    </button>
                    <span asp-validation-for="ConfirmPassword" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div class="pt-2">
                    <p class="text-[13px] font-medium text-gray-700 mb-2">I am a</p>
                    <div class="grid grid-cols-2 gap-3">
                        <label data-role-card class="cursor-pointer border-2 rounded-lg p-4 flex flex-col gap-2 @(applicantSelected ? "border-brand-600 bg-brand-50" : "border-gray-300 bg-white")">
                            <div class="flex items-center gap-2">
                                <input type="radio" asp-for="Role" value="@PropertyManagement.Web.Models.AccountRole.Applicant" class="w-4 h-4 accent-brand-600" />
                                <i data-lucide="user" class="w-5 h-5 text-gray-700"></i>
                            </div>
                            <p class="text-sm font-semibold text-ink">Applicant</p>
                            <p class="text-xs text-muted leading-snug">Find and apply for apartments and homes to call your own.</p>
                        </label>
                        <label data-role-card class="cursor-pointer border-2 rounded-lg p-4 flex flex-col gap-2 @(!applicantSelected ? "border-brand-600 bg-brand-50" : "border-gray-300 bg-white")">
                            <div class="flex items-center gap-2">
                                <input type="radio" asp-for="Role" value="@PropertyManagement.Web.Models.AccountRole.PropertyManager" class="w-4 h-4 accent-brand-600" />
                                <i data-lucide="building-2" class="w-5 h-5 text-gray-700"></i>
                            </div>
                            <p class="text-sm font-semibold text-ink">Property Manager</p>
                            <p class="text-xs text-muted leading-snug">List properties, manage applications, and find great tenants.</p>
                        </label>
                    </div>
                    <span asp-validation-for="Role" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <button type="submit"
                        class="w-full py-3 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-md transition-colors mt-2">
                    Create Account
                </button>
            </form>

            <div class="border-t border-gray-200 mt-6 pt-5 text-center">
                <p class="text-sm text-gray-500">
                    Already have an account?
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="block font-semibold text-brand-700 hover:text-brand-800 mt-0.5">Sign in</a>
                </p>
            </div>
        </div>
    </main>

    <script src="@Url.Content("~/lib/jquery/dist/jquery.min.js")"></script>
    <script src="@Url.Content("~/lib/jquery-validation/dist/jquery.validate.min.js")"></script>
    <script src="@Url.Content("~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js")"></script>
    <script>
        lucide.createIcons();

        document.querySelectorAll('[data-toggle-pwd]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(this.getAttribute('data-toggle-pwd'));
                var icon = this.querySelector('i');
                var showing = input.type === 'text';
                input.type = showing ? 'password' : 'text';
                icon.setAttribute('data-lucide', showing ? 'eye-off' : 'eye');
                lucide.createIcons();
            });
        });

        document.querySelectorAll('input[name="Role"]').forEach(function (radio) {
            radio.addEventListener('change', function () {
                document.querySelectorAll('[data-role-card]').forEach(function (card) {
                    var r = card.querySelector('input[type="radio"]');
                    if (r.checked) {
                        card.classList.add('border-brand-600', 'bg-brand-50');
                        card.classList.remove('border-gray-300', 'bg-white');
                    } else {
                        card.classList.remove('border-brand-600', 'bg-brand-50');
                        card.classList.add('border-gray-300', 'bg-white');
                    }
                });
            });
        });
    </script>
</body>
</html>
