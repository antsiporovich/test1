            <rect x="154" y="142" width="10" height="14" rx="1" fill="#d1d5db"/>

            @* Centre house *@
            <rect x="255" y="100" width="130" height="80" rx="3" fill="#e5e7eb"/>
            <polygon points="255,100 320,55 385,100" fill="#d1d5db"/>
            <rect x="300" y="130" width="40" height="50" rx="2" fill="#d1d5db"/>
            <rect x="265" y="110" width="25" height="22" rx="1" fill="#d5e9dc"/>
            <rect x="350" y="110" width="25" height="22" rx="1" fill="#d5e9dc"/>

            @* Centre left tree *@
