@{
    ViewData["Title"] = "Access denied";
}

<div class="flex flex-col items-center justify-center min-h-[calc(100vh-8rem)] px-4 py-16 text-center">

    @* Lock icon *@
    <div class="w-20 h-20 rounded-full bg-gray-100 flex items-center justify-center mb-8">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
    </div>

    @* Heading *@
    <h1 class="text-3xl font-extrabold text-gray-900 mb-3">Access Denied</h1>
    <p class="text-gray-500 text-base max-w-sm leading-relaxed mb-8">
        You don&rsquo;t have permission to view this page.<br />
        Please contact the administrator or return to the home page.
    </p>

    @* CTA *@
    <a asp-controller="Home" asp-action="Index"
       class="inline-flex items-center gap-2 px-6 py-3 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-md text-sm transition-colors">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        Back to Home
    </a>

    @* Decorative city illustration *@
    <div class="mt-16 w-full max-w-2xl mx-auto" aria-hidden="true">
        <svg viewBox="0 0 640 180" xmlns="http://www.w3.org/2000/svg" class="w-full">
            @* Left tall building *@
            <rect x="30" y="40" width="60" height="140" rx="3" fill="#e5e7eb"/>
            <rect x="38" y="52" width="12" height="16" rx="1" fill="#d1d5db"/>
            <rect x="56" y="52" width="12" height="16" rx="1" fill="#d1d5db"/>
            <rect x="74" y="52" width="12" height="16" rx="1" fill="#d1d5db"/>
            <rect x="38" y="76" width="12" height="16" rx="1" fill="#d1d5db"/>
            <rect x="56" y="76" width="12" height="16" rx="1" fill="#d1d5db"/>
            <rect x="74" y="76" width="12" height="16" rx="1" fill="#d1d5db"/>
            <rect x="38" y="100" width="12" height="16" rx="1" fill="#d1d5db"/>
            <rect x="56" y="100" width="12" height="16" rx="1" fill="#d1d5db"/>
            <rect x="74" y="100" width="12" height="16" rx="1" fill="#d1d5db"/>
            <rect x="38" y="124" width="12" height="16" rx="1" fill="#d1d5db"/>
            <rect x="56" y="124" width="12" height="16" rx="1" fill="#d1d5db"/>
            <rect x="74" y="124" width="12" height="16" rx="1" fill="#d1d5db"/>

            @* Left tree *@
            <circle cx="108" cy="110" r="22" fill="#d5e9dc"/>
            <rect x="105" y="128" width="6" height="20" rx="2" fill="#aed3ba"/>

            @* Second building *@
            <rect x="130" y="65" width="50" height="115" rx="3" fill="#e5e7eb"/>
            <rect x="138" y="76" width="10" height="14" rx="1" fill="#d1d5db"/>
            <rect x="154" y="76" width="10" height="14" rx="1" fill="#d1d5db"/>
            <rect x="138" y="98" width="10" height="14" rx="1" fill="#d1d5db"/>
            <rect x="154" y="98" width="10" height="14" rx="1" fill="#d1d5db"/>
            <rect x="138" y="120" width="10" height="14" rx="1" fill="#d1d5db"/>
            <rect x="154" y="120" width="10" height="14" rx="1" fill="#d1d5db"/>
