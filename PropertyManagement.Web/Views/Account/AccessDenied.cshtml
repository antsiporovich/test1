            <rect x="576" y="76" width="12" height="16" rx="1" fill="#d1d5db"/>
            <rect x="558" y="100" width="12" height="16" rx="1" fill="#d1d5db"/>
            <rect x="576" y="100" width="12" height="16" rx="1" fill="#d1d5db"/>
            <rect x="558" y="124" width="12" height="16" rx="1" fill="#d1d5db"/>
            <rect x="576" y="124" width="12" height="16" rx="1" fill="#d1d5db"/>

            @* Ground line *@
            <rect x="0" y="178" width="640" height="2" rx="1" fill="#e5e7eb"/>
        </svg>
    </div>

</div>
