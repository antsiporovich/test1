@{
    ViewData["Title"] = "Home";
}

@* ── Hero ──────────────────────────────────────────────────────────────── *@
<section class="relative bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 items-center gap-12 min-h-[560px] py-16 lg:py-0">

            @* Left: copy *@
            <div class="lg:order-1 max-w-lg">
                <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600 mb-5">
                    Better places. Brighter tomorrows.
                </p>
                <h1 class="text-5xl lg:text-6xl font-extrabold text-gray-900 leading-[1.08] mb-6">
                    Rental living<br class="hidden sm:block" /> made simple
                </h1>
                <p class="text-lg text-gray-500 leading-relaxed mb-10">
                    Find and manage rental properties with ease. A trusted platform for applicants and property managers.
                </p>
                <div class="flex flex-wrap gap-3">
                    <a asp-controller="Browse" asp-action="Index"
                       class="inline-flex items-center gap-2 px-6 py-3 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-md transition-colors text-sm">
                        Browse Properties
                        <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    </a>
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-controller="Account" asp-action="Register"
                           class="inline-flex items-center gap-2 px-6 py-3 bg-white border border-gray-300 hover:bg-gray-50 text-gray-800 font-semibold rounded-md transition-colors text-sm">
                            Create an Account
                        </a>
                    }
                </div>
            </div>

            @* Right: hero image with floating stat card *@
            <div class="lg:order-2 relative">
                <div class="relative rounded-2xl overflow-hidden shadow-lg h-80 lg:h-[460px]">
                    <img src="https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?w=900&q=80"
                         alt="Modern apartment complex exterior"
                         class="w-full h-full object-cover" style="transform: scaleX(-1);" />
                    <div class="absolute inset-0 bg-gradient-to-br from-brand-900/10 via-transparent to-transparent"></div>
                </div>

                @* Floating stat card *@
                <div class="absolute -bottom-5 -left-4 md:-left-8 bg-white rounded-xl shadow-lg px-5 py-4 flex items-center gap-4 border border-gray-200">
                    <div class="w-11 h-11 rounded-lg bg-brand-50 flex items-center justify-center shrink-0">
                        <i data-lucide="home" class="w-5 h-5 text-brand-600"></i>
                    </div>
                    <div>
                        <div class="text-2xl font-extrabold text-gray-900 leading-none">240+</div>
                        <div class="text-xs text-gray-400 font-medium mt-0.5">Available units</div>
                    </div>
                </div>

                @* Floating rating card *@
                <div class="absolute -top-4 -right-2 md:-right-6 bg-white rounded-xl shadow-lg px-4 py-3 flex items-center gap-3 border border-gray-200">
                    <div class="flex gap-0.5">
                        @for (int i = 0; i < 5; i++)
                        {
                            <i data-lucide="star" class="w-3.5 h-3.5 text-amber-400 fill-amber-400"></i>
                        }
                    </div>
                    <span class="text-xs font-semibold text-gray-700">4.9 / 5</span>
                </div>
            </div>

        </div>
    </div>
</section>

@* ── Features ───────────────────────────────────────────────────────────── *@
<section class="bg-gray-50 border-t border-gray-200 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="grid md:grid-cols-3 gap-10 lg:gap-16">

            <div class="flex flex-col gap-4">
                <div class="w-11 h-11 rounded-lg bg-brand-50 border border-brand-100 flex items-center justify-center">
                    <i data-lucide="search" class="w-5 h-5 text-brand-600"></i>
                </div>
                <div>
                    <h3 class="text-base font-bold text-gray-900 mb-1.5">Find the Right Fit</h3>
                    <p class="text-sm text-gray-500 leading-relaxed">
                        Search available properties that match your needs. Filter by size, neighbourhood, and monthly rent.
                    </p>
                </div>
            </div>

            <div class="flex flex-col gap-4">
                <div class="w-11 h-11 rounded-lg bg-brand-50 border border-brand-100 flex items-center justify-center">
                    <i data-lucide="file-text" class="w-5 h-5 text-brand-600"></i>
                </div>
                <div>
                    <h3 class="text-base font-bold text-gray-900 mb-1.5">Simple Applications</h3>
                    <p class="text-sm text-gray-500 leading-relaxed">
                        Apply online in just a few minutes. Track your application status in real time from your dashboard.
                    </p>
                </div>
            </div>

            <div class="flex flex-col gap-4">
                <div class="w-11 h-11 rounded-lg bg-brand-50 border border-brand-100 flex items-center justify-center">
                    <i data-lucide="shield-check" class="w-5 h-5 text-brand-600"></i>
                </div>
                <div>
                    <h3 class="text-base font-bold text-gray-900 mb-1.5">Trusted Management</h3>
                    <p class="text-sm text-gray-500 leading-relaxed">
                        A transparent and secure rental experience backed by professional property managers.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

@* ── Featured properties strip ──────────────────────────────────────────── *@
<section class="bg-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="flex items-end justify-between mb-8">
            <div>
                <p class="text-xs font-bold uppercase tracking-widest text-brand-600 mb-2">Currently available</p>
                <h2 class="text-2xl font-extrabold text-gray-900">Featured properties</h2>
            </div>
            <a asp-controller="Browse" asp-action="Index"
               class="hidden sm:inline-flex items-center gap-1.5 text-sm font-medium text-brand-600 hover:text-brand-700 transition-colors">
                View all <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </a>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">

            @* Card 1 *@
            <article class="bg-white border border-gray-200 rounded-xl overflow-hidden hover:shadow-md transition-shadow group">
                <div class="relative h-44 overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=600&q=75"
                         alt="Oakwood Residences"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                    <span class="absolute top-3 left-3 inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-green-50 text-green-700 border border-green-100">
                        Available
                    </span>
                </div>
                <div class="p-5">
                    <div class="flex items-start justify-between gap-2 mb-1">
                        <h3 class="font-bold text-gray-900 text-[15px]">Oakwood Residences</h3>
                        <span class="text-brand-700 font-bold text-sm shrink-0">$1,850/mo</span>
                    </div>
                    <p class="text-xs text-gray-400 flex items-center gap-1 mb-4">
                        <i data-lucide="map-pin" class="w-3 h-3"></i>
                        742 Evergreen Terrace, Springfield
                    </p>
                    <div class="flex items-center gap-4 text-xs text-gray-500">
                        <span class="flex items-center gap-1"><i data-lucide="bed-double" class="w-3.5 h-3.5"></i> 2 bed</span>
                        <span class="flex items-center gap-1"><i data-lucide="bath" class="w-3.5 h-3.5"></i> 1 bath</span>
                        <span class="flex items-center gap-1"><i data-lucide="ruler" class="w-3.5 h-3.5"></i> 820 sq ft</span>
                    </div>
                </div>
            </article>

            @* Card 2 *@
            <article class="bg-white border border-gray-200 rounded-xl overflow-hidden hover:shadow-md transition-shadow group">
                <div class="relative h-44 overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=600&q=75"
                         alt="The Lakeview Flats"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                    <span class="absolute top-3 left-3 inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-green-50 text-green-700 border border-green-100">
                        Available
                    </span>
                </div>
                <div class="p-5">
                    <div class="flex items-start justify-between gap-2 mb-1">
                        <h3 class="font-bold text-gray-900 text-[15px]">The Lakeview Flats</h3>
                        <span class="text-brand-700 font-bold text-sm shrink-0">$2,200/mo</span>
                    </div>
                    <p class="text-xs text-gray-400 flex items-center gap-1 mb-4">
                        <i data-lucide="map-pin" class="w-3 h-3"></i>
                        14 Harbor Point Blvd, Maplewood
                    </p>
                    <div class="flex items-center gap-4 text-xs text-gray-500">
                        <span class="flex items-center gap-1"><i data-lucide="bed-double" class="w-3.5 h-3.5"></i> 3 bed</span>
                        <span class="flex items-center gap-1"><i data-lucide="bath" class="w-3.5 h-3.5"></i> 2 bath</span>
                        <span class="flex items-center gap-1"><i data-lucide="ruler" class="w-3.5 h-3.5"></i> 1,105 sq ft</span>
                    </div>
                </div>
            </article>

            @* Card 3 *@
            <article class="bg-white border border-gray-200 rounded-xl overflow-hidden hover:shadow-md transition-shadow group">
                <div class="relative h-44 overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1493809842364-78817add7ffb?w=600&q=75"
                         alt="Meridian Suites"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                    <span class="absolute top-3 left-3 inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-green-50 text-green-700 border border-green-100">
                        Available
                    </span>
                </div>
                <div class="p-5">
                    <div class="flex items-start justify-between gap-2 mb-1">
                        <h3 class="font-bold text-gray-900 text-[15px]">Meridian Suites</h3>
                        <span class="text-brand-700 font-bold text-sm shrink-0">$1,650/mo</span>
                    </div>
                    <p class="text-xs text-gray-400 flex items-center gap-1 mb-4">
                        <i data-lucide="map-pin" class="w-3 h-3"></i>
                        33 Birchwood Lane, Clearwater
                    </p>
                    <div class="flex items-center gap-4 text-xs text-gray-500">
                        <span class="flex items-center gap-1"><i data-lucide="bed-double" class="w-3.5 h-3.5"></i> 1 bed</span>
                        <span class="flex items-center gap-1"><i data-lucide="bath" class="w-3.5 h-3.5"></i> 1 bath</span>
                        <span class="flex items-center gap-1"><i data-lucide="ruler" class="w-3.5 h-3.5"></i> 640 sq ft</span>
                    </div>
                </div>
            </article>

        </div>

        <div class="mt-8 text-center sm:hidden">
            <a asp-controller="Browse" asp-action="Index"
               class="inline-flex items-center gap-1.5 text-sm font-medium text-brand-600 hover:text-brand-700 transition-colors">
                View all properties <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </a>
        </div>

    </div>
</section>

@* ── CTA banner ─────────────────────────────────────────────────────────── *@
@if (User.Identity?.IsAuthenticated != true)
{
    <section class="bg-brand-700 py-14">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="text-2xl font-extrabold text-white mb-3">Ready to find your next home?</h2>
            <p class="text-brand-200 mb-7 text-base leading-relaxed">
                Join hundreds of renters who found their perfect place through our platform.
                Create an account and start applying today.
            </p>
            <div class="flex flex-wrap justify-center gap-3">
                <a asp-controller="Account" asp-action="Register"
                   class="px-6 py-3 bg-white text-brand-700 font-semibold rounded-md hover:bg-brand-50 transition-colors text-sm">
                    Get started — it&rsquo;s free
                </a>
                <a asp-controller="Browse" asp-action="Index"
                   class="px-6 py-3 border border-brand-500 text-white font-semibold rounded-md hover:bg-brand-600 transition-colors text-sm">
                    Browse without signing in
                </a>
            </div>
        </div>
    </section>
}
