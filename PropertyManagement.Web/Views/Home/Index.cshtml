@{
    ViewData["Title"] = "Home";
}

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-16 lg:pb-20">
    <div class="relative rounded-2xl overflow-hidden min-h-[440px] flex items-center">
        <img src="@Url.Content("~/images/hero-building.jpg")" alt="Modern apartment building"
             class="absolute inset-0 w-full h-full object-cover">
        <div class="absolute inset-0 bg-gradient-to-r from-white from-[15%] via-white/85 via-[45%] to-transparent"></div>

        <div class="relative px-8 sm:px-12 py-16 max-w-xl">
            <p class="text-xs font-semibold text-gray-400 tracking-[0.2em] uppercase mb-4">Rent &nbsp;·&nbsp; Manage &nbsp;·&nbsp; Thrive</p>
            <h1 class="text-4xl sm:text-5xl font-extrabold text-ink leading-[1.1] mb-6">
                Find and manage<br>rental homes with<br>ease
            </h1>
            <p class="text-lg text-muted leading-relaxed mb-8 max-w-md">
                Discover quality rental properties, submit applications online, and manage your rentals — all in one place.
            </p>
            <div class="flex flex-wrap items-center gap-4">
                <a asp-controller="Browse" asp-action="Index"
                   class="inline-flex items-center gap-2 px-5 py-3 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-md transition-colors">
                    Browse Units
                    <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </a>
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Account" asp-action="Register"
                       class="inline-flex items-center px-5 py-3 border border-gray-300 hover:bg-gray-50 bg-white/80 text-gray-700 text-sm font-semibold rounded-md transition-colors">
                        Create Account
                    </a>
                }
            </div>
        </div>
    </div>
</section>

<section class="bg-white border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="grid md:grid-cols-3 gap-10 text-center">
            <div>
                <i data-lucide="home" class="w-9 h-9 text-brand-600 mx-auto mb-4" stroke-width="1.8"></i>
                <h3 class="text-base font-bold text-ink mb-2">Browse Available Units</h3>
                <p class="text-sm text-muted leading-relaxed max-w-xs mx-auto">Explore a wide selection of rental homes that fit your needs.</p>
            </div>
            <div>
                <i data-lucide="file-text" class="w-9 h-9 text-brand-600 mx-auto mb-4" stroke-width="1.8"></i>
                <h3 class="text-base font-bold text-ink mb-2">Apply Online</h3>
                <p class="text-sm text-muted leading-relaxed max-w-xs mx-auto">Submit your application quickly and securely, all online.</p>
            </div>
            <div>
                <i data-lucide="settings" class="w-9 h-9 text-brand-600 mx-auto mb-4" stroke-width="1.8"></i>
                <h3 class="text-base font-bold text-ink mb-2">Property Management</h3>
                <p class="text-sm text-muted leading-relaxed max-w-xs mx-auto">A better way to manage properties for owners and tenants.</p>
            </div>
        </div>
    </div>
</section>
