@model PropertyManagement.Web.Models.UnitFormViewModel
@{
    var isEdit = Model.Id != 0;
    var actionUrl = isEdit
        ? Url.Action("Edit", "Units", new { propertyId = Model.PropertyId, unitId = Model.Id })
        : Url.Action("Create", "Units", new { propertyId = Model.PropertyId });
}

<div class="modal-header">
    <h5 class="modal-title">@(isEdit ? "Edit unit" : "Add unit")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<form method="post" action="@actionUrl">
    @Html.AntiForgeryToken()
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="PropertyId" />

        <div class="mb-3">
            <label asp-for="UnitNumber" class="form-label"></label>
            <input asp-for="UnitNumber" class="form-control" />
            <span asp-validation-for="UnitNumber" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col mb-3">
                <label asp-for="Bedrooms" class="form-label"></label>
                <input asp-for="Bedrooms" class="form-control" type="number" min="0" />
                <span asp-validation-for="Bedrooms" class="text-danger"></span>
            </div>
            <div class="col mb-3">
                <label asp-for="MonthlyRent" class="form-label"></label>
                <input asp-for="MonthlyRent" class="form-control" type="number" step="0.01" min="0.01" />
                <span asp-validation-for="MonthlyRent" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="UnitTypeId" class="form-label"></label>
            <select asp-for="UnitTypeId" asp-items="Model.UnitTypeOptions" class="form-select">
                <option value="">-- Select a unit type --</option>
            </select>
            <span asp-validation-for="UnitTypeId" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
