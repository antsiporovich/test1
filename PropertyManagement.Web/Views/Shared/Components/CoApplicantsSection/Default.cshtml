@model PropertyManagement.Web.Models.CoApplicantsListViewModel

<div class="flex items-center justify-between mb-3">
    <h3 class="text-sm font-bold text-ink">Co-Applicants</h3>
    @if (Model.IsEditable)
    {
        <button type="button"
                class="text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors"
                data-ajax-modal-url="@Url.Action("AddApplicantForm", "Applications", new { applicationId = Model.ApplicationId })"
                data-refresh-url="@Url.Action("CoApplicantsPartial", "Applications", new { applicationId = Model.ApplicationId })"
                data-refresh-target="#coApplicantsRegion">
            + Add Co-Applicant
        </button>
    }
</div>

@if (Model.Applicants.Count == 0)
{
    <p class="text-sm text-gray-400">No co-applicants yet.</p>
}
else
{
    <ul class="divide-y divide-gray-100 text-xs">
        @foreach (var a in Model.Applicants)
        {
            <li class="py-2.5 text-gray-900 first:pt-0 last:pb-0">
                <span class="font-medium">@a.DisplayName</span>
                <span class="text-gray-400">(@a.Email)</span>
            </li>
        }
    </ul>
}
