@model PropertyManagement.Web.Models.GridViewModel
@using System.Text.Json
@{
    var hasActions = !string.IsNullOrEmpty(Model.RowActionLabel);
    var useFixed = Model.Columns.Count <= 4;
    var hasWidths = Model.Columns.Any(c => !string.IsNullOrEmpty(c.Width));
}

<div class="grid-component"
     data-grid-endpoint="@Model.ApiEndpoint"
     data-grid-page-size="@Model.PageSize"
     data-grid-row-url-template="@Model.RowUrlTemplate"
     data-grid-row-action-label="@Model.RowActionLabel"
     data-grid-show-overflow="@(Model.ShowRowOverflowMenu ? "true" : "false")"
     data-grid-item-label="@Model.ItemLabel"
     data-grid-search-input-id="@Model.SearchInputId"
     data-grid-fixed-params="@JsonSerializer.Serialize(Model.FixedParams)"
     data-grid-filter-input-ids="@JsonSerializer.Serialize(Model.FilterInputIds)">
    <div class="overflow-x-auto grid-table-wrap">
        <table class="w-full text-xs @(useFixed ? "table-fixed" : "")">
            @if (useFixed && hasWidths)
            {
                <colgroup>
                    @foreach (var col in Model.Columns)
                    {
                        if (!string.IsNullOrEmpty(col.Width))
                        {
                            <col style="width:@col.Width" />
                        }
                        else
                        {
                            <col />
                        }
                    }
                    @if (hasActions)
                    {
                        if (!string.IsNullOrEmpty(Model.ActionColumnWidth))
                        {
                            <col style="width:@Model.ActionColumnWidth" />
                        }
                        else
                        {
                            <col />
                        }
                    }
                </colgroup>
            }
            <thead>
                <tr class="bg-gray-50 border-y border-gray-200">
                    @foreach (var col in Model.Columns)
                    {
                        <th data-key="@col.Key" data-sortable="@col.Sortable.ToString().ToLowerInvariant()" data-type="@col.Type"
                            class="text-left px-5 py-2.5 text-xs font-semibold text-gray-500 select-none @(col.Sortable ? "cursor-pointer" : "")">
                            @if (col.Sortable)
                            {
                                <span class="inline-flex items-center gap-1 hover:text-gray-800">
                                    @col.Header
                                    <i data-lucide="chevrons-up-down" class="w-3.5 h-3.5 text-gray-400 grid-sort-icon"></i>
                                </span>
                            }
                            else
                            {
                                @col.Header
                            }
                        </th>
                    }
                    @if (hasActions)
                    {
                        <th class="text-right px-5 py-2.5 text-xs font-semibold text-gray-500">Actions</th>
                    }
                </tr>
            </thead>
            <tbody class="grid-body">
                <tr>
                    <td colspan="@(Model.Columns.Count + (hasActions ? 1 : 0))" class="px-6 py-8 text-center text-sm text-gray-400">Loading…</td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-3.5 border-t border-gray-200">
        <span class="grid-summary text-xs text-muted"></span>
        <nav class="grid-pager flex items-center gap-1.5"></nav>
    </div>
</div>
