@model PropertyManagement.Web.Models.UnitListViewModel

@if (Model.Units.Count == 0)
{
    <p class="px-5 py-4 text-sm text-gray-400">No units yet.</p>
}
else
{
    <div class="overflow-x-auto">
        <table class="w-full text-xs table-fixed min-w-[36rem]">
            <colgroup>
                <col class="w-[12%]" />
                <col class="w-[12%]" />
                <col class="w-[12%]" />
                <col class="w-[16%]" />
                <col class="w-[18%]" />
                <col class="w-[30%]" />
            </colgroup>
            <thead>
                <tr class="bg-gray-50 border-b border-gray-200">
                    <th class="text-left px-3 py-2.5 font-semibold text-gray-500">Unit #</th>
                    <th class="text-left px-3 py-2.5 font-semibold text-gray-500">Bedrooms</th>
                    <th class="text-left px-3 py-2.5 font-semibold text-gray-500">Rent</th>
                    <th class="text-left px-3 py-2.5 font-semibold text-gray-500">Type</th>
                    <th class="text-left px-3 py-2.5 font-semibold text-gray-500">Availability</th>
                    <th class="text-right px-3 py-2.5 font-semibold text-gray-500">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var unit in Model.Units)
                {
                    <tr class="border-b border-gray-100 last:border-0 hover:bg-gray-50/70 transition-colors">
                        <td class="px-3 py-2.5 text-gray-700">@unit.UnitNumber</td>
                        <td class="px-3 py-2.5 text-gray-700">@unit.Bedrooms</td>
                        <td class="px-3 py-2.5 text-gray-700">@unit.MonthlyRent.ToString("C0")</td>
                        <td class="px-3 py-2.5 text-gray-700 truncate" title="@unit.UnitTypeName">@unit.UnitTypeName</td>
                        <td class="px-3 py-2.5">
                            @if (unit.IsAvailable)
                            {
                                <span class="inline-flex px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-100 text-emerald-800">Available</span>
                            }
                            else
                            {
                                <span class="inline-flex px-2.5 py-1 rounded-full text-[11px] font-semibold bg-red-100 text-red-800">Unavailable</span>
                            }
                        </td>
                        <td class="px-3 py-2.5 text-right whitespace-nowrap">
                            <div class="inline-flex items-center justify-end gap-2">
                                <button type="button" class="inline-flex items-center justify-center w-[75px] py-1.5 border border-gray-300 text-gray-700 text-xs font-semibold rounded-md hover:bg-gray-50 transition-colors"
                                        data-ajax-modal-url="@Url.Action("EditForm", "Units", new { propertyId = unit.PropertyId, unitId = unit.Id })"
                                        data-refresh-url="@Url.Action("UnitsPartial", "Units", new { propertyId = unit.PropertyId })"
                                        data-refresh-target="#unitListRegion-@unit.PropertyId">
                                    Edit
                                </button>
                                <button type="button" class="inline-flex items-center justify-center w-[75px] py-1.5 border border-red-200 text-red-700 text-xs font-semibold rounded-md hover:bg-red-50 transition-colors"
                                        data-ajax-remove-url="@Url.Action("Remove", "Units", new { propertyId = unit.PropertyId, unitId = unit.Id })"
                                        data-confirm="Remove unit @unit.UnitNumber?"
                                        data-refresh-url="@Url.Action("UnitsPartial", "Units", new { propertyId = unit.PropertyId })"
                                        data-refresh-target="#unitListRegion-@unit.PropertyId">
                                    Remove
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
