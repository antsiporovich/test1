@model PropertyManagement.Web.Models.ResidenceHistoryListViewModel

<h2 class="h4">Residence History</h2>
<p class="text-muted small">Add any prior residences (optional) — you may continue with none listed.</p>

@if (Model.IsEditable)
{
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-primary"
                data-ajax-modal-url="@Url.Action("CreateResidenceForm", "Applications", new { applicationId = Model.ApplicationId })"
                data-refresh-url="@Url.Action("ResidenceHistoryPartial", "Applications", new { applicationId = Model.ApplicationId })"
                data-refresh-target="#residenceHistoryRegion">
            Add Residence
        </button>
    </div>
}

@if (Model.Residences.Count == 0)
{
    <p class="text-muted">No prior residences added yet.</p>
}
else
{
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>Address</th>
                <th>Landlord</th>
                <th>Move-in</th>
                <th>Move-out</th>
                @if (Model.IsEditable)
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Residences)
            {
                <tr>
                    <td>@r.AddressLine1, @r.City, @r.State @r.ZipCode</td>
                    <td>@r.LandlordName (@r.LandlordPhone)</td>
                    <td>@r.MoveInDate.ToString("d")</td>
                    <td>@(r.MoveOutDate?.ToString("d") ?? "Current")</td>
                    @if (Model.IsEditable)
                    {
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-ajax-modal-url="@Url.Action("EditResidenceForm", "Applications", new { applicationId = Model.ApplicationId, residenceId = r.Id })"
                                    data-refresh-url="@Url.Action("ResidenceHistoryPartial", "Applications", new { applicationId = Model.ApplicationId })"
                                    data-refresh-target="#residenceHistoryRegion">
                                Edit
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    data-ajax-remove-url="@Url.Action("RemoveResidence", "Applications", new { applicationId = Model.ApplicationId, residenceId = r.Id })"
                                    data-confirm="Remove this residence?"
                                    data-refresh-url="@Url.Action("ResidenceHistoryPartial", "Applications", new { applicationId = Model.ApplicationId })"
                                    data-refresh-target="#residenceHistoryRegion">
                                Remove
                            </button>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
