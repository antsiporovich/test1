@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="flex flex-col items-center justify-center min-h-[calc(100vh-4rem)] px-4 py-16 text-center">
    <div class="w-20 h-20 rounded-full bg-red-50 flex items-center justify-center mb-8">
        <i data-lucide="alert-triangle" class="w-9 h-9 text-red-400"></i>
    </div>
    <h1 class="text-3xl font-extrabold text-ink mb-3">Something went wrong</h1>
    <p class="text-muted text-base max-w-md leading-relaxed mb-2">
        An unexpected error occurred while processing your request.
    </p>
    @if (Model.ShowRequestId)
    {
        <p class="text-xs text-gray-400 mb-8 font-mono">Request ID: @Model.RequestId</p>
    }
    else
    {
        <div class="mb-8"></div>
    }
    <a asp-controller="Home" asp-action="Index"
       class="inline-flex items-center gap-2 px-6 py-3 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-md text-sm transition-colors">
        <i data-lucide="home" class="w-4 h-4"></i>
        Back to Home
    </a>
</div>
