<!DOCTYPE html>
<html lang="en" class="h-full scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PropertyManagement</title>

    @* Tailwind via CDN — replace with compiled bundle before production *@
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50:  '#eef6f1',
                            100: '#d5e9dc',
                            200: '#aed3ba',
                            500: '#2b9e5f',
                            600: '#1e8a4f',
                            700: '#17703f',
                            800: '#135b34',
                            900: '#0e4527',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />

    @* Bootstrap CSS is kept so un-migrated partial views (modal bodies, form controls)
       retain their layout while screens are being converted to Tailwind one-by-one.
       Remove once every view has been migrated. *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PropertyManagement.Web.styles.css" asp-append-version="true" />

    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>

    @await RenderSectionAsync("Head", required: false)
</head>
<body class="h-full bg-gray-50 font-sans antialiased flex flex-col">
@{
    var navController = ViewContext.RouteData.Values["controller"] as string ?? "";
    var navAction = ViewContext.RouteData.Values["action"] as string ?? "";
    bool NavActive(string controller, string? action = null) =>
        string.Equals(navController, controller, StringComparison.OrdinalIgnoreCase)
        && (action is null || string.Equals(navAction, action, StringComparison.OrdinalIgnoreCase));
    const string navBase = "inline-flex items-center h-16 -mb-px border-b-2 text-sm transition-colors";
    const string navOn = " border-brand-600 text-brand-700 font-semibold";
    const string navOff = " border-transparent text-gray-500 hover:text-gray-800 font-medium";
}

    <header class="sticky top-0 z-40 bg-white border-b border-gray-200">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">

                <div class="flex items-center gap-8">
                    <a asp-controller="Home" asp-action="Index"
                       class="flex items-center gap-2 text-gray-900 hover:text-brand-700 transition-colors group">
                        <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-brand-600 group-hover:bg-brand-700 transition-colors">
                            <i data-lucide="building-2" class="w-4 h-4 text-white"></i>
                        </span>
                        <span class="font-bold text-base tracking-tight">PropertyManagement</span>
                    </a>

                    <div class="hidden md:flex items-center gap-6">
                        <a asp-controller="Home" asp-action="Index" class="@(navBase + (NavActive("Home", "Index") ? navOn : navOff))">Home</a>
                        <a asp-controller="Home" asp-action="Privacy" class="@(navBase + (NavActive("Home", "Privacy") ? navOn : navOff))">Privacy</a>
                        @if (User.IsInRole("PropertyManager"))
                        {
                            <a asp-controller="Properties" asp-action="Index" class="@(navBase + (NavActive("Properties") ? navOn : navOff))">Properties</a>
                        }
                        @if (User.IsInRole("Applicant"))
                        {
                            <a asp-controller="Browse" asp-action="Index" class="@(navBase + (NavActive("Browse") ? navOn : navOff))">Browse Units</a>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Applications" asp-action="Index" class="@(navBase + (NavActive("Applications") ? navOn : navOff))">Applications</a>
                        }
                    </div>
                </div>

                <div class="flex items-center gap-4">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="hidden md:inline text-sm text-gray-500 max-w-[180px] truncate">@User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit"
                                    class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-sm font-medium text-gray-600 hover:text-gray-900 border border-gray-300 rounded-md hover:bg-gray-50 transition-colors">
                                <i data-lucide="log-out" class="w-3.5 h-3.5"></i>
                                Log out
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login"
                           class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">
                            Login
                        </a>
                        <a asp-controller="Account" asp-action="Register"
                           class="px-4 py-2 text-sm font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-md transition-colors">
                            Register
                        </a>
                    }
                </div>

            </div>
        </nav>
    </header>

    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 pt-4">
            <div role="alert" class="flex items-center gap-3 px-4 py-3 bg-green-50 border border-green-200 text-green-800 rounded-xl text-sm font-medium">
                <i data-lucide="check-circle-2" class="w-4 h-4 shrink-0 text-green-600"></i>
                @successMsg
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 pt-4">
            <div role="alert" class="flex items-center gap-3 px-4 py-3 bg-red-50 border border-red-200 text-red-800 rounded-xl text-sm font-medium">
                <i data-lucide="alert-circle" class="w-4 h-4 shrink-0 text-red-500"></i>
                @errorMsg
            </div>
        </div>
    }

    <main class="flex-1">
        @RenderBody()
    </main>

    <footer class="bg-white border-t border-gray-100 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-gray-400">
            <span>&copy; 2026 PropertyManagement. All rights reserved.</span>
            <a asp-controller="Home" asp-action="Privacy" class="hover:text-gray-600 transition-colors">Privacy Policy</a>
        </div>
    </footer>

    @* Global AJAX modal shell — Bootstrap JS drives open/close; ajaxModal.js injects partials into #ajaxModalBody *@
    <div class="modal fade" id="ajaxModal" tabindex="-1" aria-hidden="true" aria-labelledby="ajaxModalLabel">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-2xl border-0 shadow-2xl overflow-hidden" id="ajaxModalBody">
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/ajaxModal.js" asp-append-version="true"></script>
    <script src="~/js/grid.js" asp-append-version="true"></script>
    <script>lucide.createIcons();</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
