<!DOCTYPE html>
<html lang="en" class="h-full scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — HomePlace</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50:  '#edf8f3',
                            100: '#d7efe4',
                            200: '#afdfc9',
                            500: '#3b916a',
                            600: '#29664a',
                            700: '#20503a',
                            800: '#193e2d',
                            900: '#132f22',
                        },
                        ink:   '#0b1220',
                        muted: '#4e5867',
                        mist:  '#ecf1f4',
                    },
                    fontFamily: {
                        sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />

    @* Bootstrap kept only for #ajaxModal positioning *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PropertyManagement.Web.styles.css" asp-append-version="true" />

    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="h-full bg-mist text-ink font-sans antialiased flex flex-col">
@{
    var navController = ViewContext.RouteData.Values["controller"] as string ?? "";
    var navAction = ViewContext.RouteData.Values["action"] as string ?? "";
    bool NavActive(string controller, string? action = null) =>
        string.Equals(navController, controller, StringComparison.OrdinalIgnoreCase)
        && (action is null || string.Equals(navAction, action, StringComparison.OrdinalIgnoreCase));
    const string navBase = "h-16 flex items-center border-b-2 text-sm transition-colors";
    const string navOn = " border-brand-600 text-brand-700 font-semibold";
    const string navOff = " border-transparent text-gray-500 hover:text-gray-800 font-medium";

    var userEmail = User.Identity?.Name ?? "";
    var initials = string.IsNullOrEmpty(userEmail)
        ? "?"
        : string.Concat(userEmail.Split('@')[0]
            .Split('.', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(p => char.ToUpperInvariant(p[0])));
}

    <header class="sticky top-0 z-40 bg-white border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-8">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2">
                    <i data-lucide="home" class="w-7 h-7 text-brand-600" stroke-width="2.2"></i>
                    <span class="font-bold text-lg text-ink tracking-tight">HomePlace</span>
                </a>

                <nav class="hidden md:flex items-center gap-6 h-16">
                    <a asp-controller="Home" asp-action="Index" class="@(navBase + (NavActive("Home", "Index") ? navOn : navOff))">Home</a>
                    <a asp-controller="Home" asp-action="Privacy" class="@(navBase + (NavActive("Home", "Privacy") ? navOn : navOff))">Privacy</a>
                    @if (User.IsInRole("PropertyManager"))
                    {
                        <a asp-controller="Properties" asp-action="Index" class="@(navBase + (NavActive("Properties") ? navOn : navOff))">Properties</a>
                    }
                    @if (User.IsInRole("Applicant"))
                    {
                        <a asp-controller="Browse" asp-action="Index" class="@(navBase + (NavActive("Browse") ? navOn : navOff))">Browse Units</a>
                    }
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Applications" asp-action="Index" class="@(navBase + (NavActive("Applications") ? navOn : navOff))">Applications</a>
                    }
                </nav>
            </div>

            <div class="flex items-center gap-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="hidden sm:flex w-8 h-8 rounded-full bg-brand-100 text-brand-700 text-xs font-bold items-center justify-center">@initials</span>
                    <span class="hidden sm:inline-flex items-center gap-1.5 text-sm text-gray-600 font-medium max-w-[200px] truncate">
                        @userEmail
                        <i data-lucide="chevron-down" class="w-4 h-4 text-gray-400 shrink-0"></i>
                    </span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                        <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-md transition-colors">
                            Log out
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="text-sm text-gray-600 hover:text-gray-900 font-medium transition-colors">Login</a>
                    <a asp-controller="Account" asp-action="Register" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-md transition-colors">Register</a>
                }
            </div>
        </div>
    </header>

    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 pt-4">
            <div role="alert" class="flex items-center gap-3 px-4 py-3 bg-green-50 border border-green-200 text-green-800 rounded-xl text-sm font-medium">
                <i data-lucide="check-circle-2" class="w-4 h-4 shrink-0 text-green-600"></i>
                @successMsg
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 pt-4">
            <div role="alert" class="flex items-center gap-3 px-4 py-3 bg-red-50 border border-red-200 text-red-800 rounded-xl text-sm font-medium">
                <i data-lucide="alert-circle" class="w-4 h-4 shrink-0 text-red-500"></i>
                @errorMsg
            </div>
        </div>
    }

    <main class="flex-1">
        @RenderBody()
    </main>

    <div class="modal fade" id="ajaxModal" tabindex="-1" aria-hidden="true" aria-labelledby="ajaxModalLabel">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-xl border-0 shadow-xl overflow-hidden" id="ajaxModalBody">
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/ajaxModal.js" asp-append-version="true"></script>
    <script src="~/js/grid.js" asp-append-version="true"></script>
    <script>lucide.createIcons();</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
