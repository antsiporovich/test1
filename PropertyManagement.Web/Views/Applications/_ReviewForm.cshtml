@model PropertyManagement.Web.Models.ReviewFormViewModel
@* REVIEW-1: modal partial — returned by GET /Applications/{id}/Review and re-rendered
   in-place by ajaxModal.js when the POST fails validation. *@

<div class="flex items-start justify-between px-6 pt-5">
    <h5 class="text-base font-bold text-gray-900">Review Application</h5>
    <button type="button" class="text-gray-400 hover:text-gray-600 transition-colors -mr-1" data-bs-dismiss="modal" aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
</div>

<div class="px-6 pt-3">
    <p class="text-[15px] font-bold text-gray-900">@Model.ApplicantName</p>
    <p class="text-[13px] text-gray-500 mt-0.5">@Model.PropertyUnit</p>
</div>

<form method="post" asp-controller="Applications" asp-action="Review" asp-route-id="@Model.ApplicationId">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ApplicationId" />
    <div class="px-6 pt-4 pb-5">
        <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm empty:hidden" role="alert"></div>

        <fieldset class="mb-5">
            <legend class="text-sm font-semibold text-gray-900 mb-3">Decision</legend>
            <div class="space-y-3">
                <label class="flex items-start gap-3 cursor-pointer">
                    <input type="radio" asp-for="Outcome" value="Approve"
                           class="mt-0.5 w-4 h-4 accent-brand-600 border-gray-300 focus:ring-brand-600" />
                    <span>
                        <span class="block text-sm font-semibold text-gray-900 leading-tight">Approve</span>
                        <span class="block text-xs text-gray-500 mt-0.5">Application is approved and can move forward.</span>
                    </span>
                </label>
                <label class="flex items-start gap-3 cursor-pointer">
                    <input type="radio" asp-for="Outcome" value="Return"
                           class="mt-0.5 w-4 h-4 accent-brand-600 border-gray-300 focus:ring-brand-600" />
                    <span>
                        <span class="block text-sm font-semibold text-gray-900 leading-tight">Return for Correction</span>
                        <span class="block text-xs text-gray-500 mt-0.5">Send back to applicant for additional information.</span>
                    </span>
                </label>
                <label class="flex items-start gap-3 cursor-pointer">
                    <input type="radio" asp-for="Outcome" value="Deny"
                           class="mt-0.5 w-4 h-4 accent-brand-600 border-gray-300 focus:ring-brand-600" />
                    <span>
                        <span class="block text-sm font-semibold text-gray-900 leading-tight">Deny</span>
                        <span class="block text-xs text-gray-500 mt-0.5">Application is not approved.</span>
                    </span>
                </label>
            </div>
            <span asp-validation-for="Outcome" class="text-xs text-red-500 mt-2 block"></span>
        </fieldset>

        <div>
            <label asp-for="Comment" class="block text-sm font-medium text-gray-700 mb-1.5">Comments</label>
            <textarea asp-for="Comment" rows="4" maxlength="500" data-counter="reviewCommentCount"
                      placeholder="Add a comment (optional)…"
                      class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors resize-none"></textarea>
            <div class="flex items-center justify-between mt-1">
                <span asp-validation-for="Comment" class="text-xs text-red-500"></span>
                <span id="reviewCommentCount" class="text-xs text-gray-400 ml-auto">0 / 500</span>
            </div>
        </div>
    </div>
    <div class="flex justify-end gap-3 px-6 py-4 border-t border-gray-200 bg-gray-50/60">
        <button type="button" class="px-4 py-2 border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-md transition-colors" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-md transition-colors">Submit Review</button>
    </div>
</form>
