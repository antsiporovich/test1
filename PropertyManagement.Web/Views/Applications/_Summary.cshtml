@model PropertyManagement.Web.Models.ApplicationWizardViewModel
@{
    var info = Model.ApplicantInformation;
    var addressParts = new[] { info.AddressLine1, info.AddressLine2, $"{info.City}, {info.State} {info.ZipCode}" }
        .Where(p => !string.IsNullOrWhiteSpace(p));
}

<h2 class="text-lg font-bold text-gray-900 mb-5">Summary</h2>

@if (Model.OutstandingErrors.Count > 0)
{
    <div class="mb-6 px-4 py-3.5 bg-red-50 border border-red-200 rounded-xl text-sm">
        <p class="font-semibold text-red-700 mb-1.5">Please complete this field</p>
        <ul class="space-y-1 text-red-600">
            @foreach (var error in Model.OutstandingErrors)
            {
                <li>@error.Message</li>
            }
        </ul>
    </div>
}

<div class="space-y-5">

    <div class="bg-white border border-gray-100 rounded-2xl p-5">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-bold text-gray-900">Applicant Information</h3>
        </div>
        <dl class="grid sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
            <div><dt class="text-gray-400 text-xs mb-0.5">Name</dt><dd class="text-gray-900">@info.FullName</dd></div>
            <div><dt class="text-gray-400 text-xs mb-0.5">Phone</dt><dd class="text-gray-900">@info.Phone</dd></div>
            <div><dt class="text-gray-400 text-xs mb-0.5">Email</dt><dd class="text-gray-900">@info.Email</dd></div>
            <div><dt class="text-gray-400 text-xs mb-0.5">Current Address</dt><dd class="text-gray-900">@string.Join(", ", addressParts)</dd></div>
        </dl>
    </div>

    <div class="bg-white border border-gray-100 rounded-2xl p-5">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-bold text-gray-900">Residence History</h3>
        </div>
        @if (Model.Residences.Count == 0)
        {
            <p class="text-sm text-gray-400">No prior residences.</p>
        }
        else
        {
            <div class="overflow-x-auto -mx-5">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-gray-100">
                            <th class="text-left px-5 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wide">Address</th>
                            <th class="text-left px-5 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wide">Landlord</th>
                            <th class="text-left px-5 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wide">Move-in</th>
                            <th class="text-left px-5 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wide">Move-out</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Residences)
                        {
                            <tr class="border-b border-gray-50 last:border-0">
                                <td class="px-5 py-2.5 text-gray-900">@r.AddressLine1, @r.City, @r.State @r.ZipCode</td>
                                <td class="px-5 py-2.5 text-gray-700">@r.LandlordName</td>
                                <td class="px-5 py-2.5 text-gray-700">@r.MoveInDate.ToString("MM/dd/yyyy")</td>
                                <td class="px-5 py-2.5 text-gray-700">@(r.MoveOutDate?.ToString("MM/dd/yyyy") ?? "Current")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="bg-white border border-gray-100 rounded-2xl p-5" id="coApplicantsRegion">
        @await Component.InvokeAsync("CoApplicantsSection", new { applicationId = Model.ApplicationId, isEditable = Model.IsEditable })
    </div>

</div>
