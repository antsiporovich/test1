@model PropertyManagement.Web.Models.ApplicationWizardViewModel
@{
    var info = Model.ApplicantInformation;
    var addressParts = new[] { info.AddressLine1, info.AddressLine2, $"{info.City}, {info.State} {info.ZipCode}" }
        .Where(p => !string.IsNullOrWhiteSpace(p));
}

@if (Model.OutstandingErrors.Count > 0)
{
    <div class="mb-6 px-4 py-3.5 bg-red-50 border border-red-200 rounded-xl text-sm">
        <p class="font-semibold text-red-700 mb-1.5">Please complete the following before submitting</p>
        <ul class="space-y-1 text-red-600">
            @foreach (var error in Model.OutstandingErrors)
            {
                <li>@error.Message</li>
            }
        </ul>
    </div>
}

<div class="space-y-5">

    <div class="border border-gray-200 rounded-xl overflow-hidden">
        <div class="px-5 py-3 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
            <h3 class="text-sm font-bold text-ink">Applicant Information</h3>
            @if (Model.IsEditable)
            {
                <a asp-action="Wizard" asp-route-id="@Model.ApplicationId" asp-route-step="@WizardStep.ApplicantInformation"
                   class="text-xs font-semibold text-brand-600 hover:text-brand-700">Edit</a>
            }
        </div>
        <dl class="px-5 py-4 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3 text-xs">
            <div><dt class="text-gray-400 mb-0.5">Name</dt><dd class="text-gray-900 font-medium">@info.FullName</dd></div>
            <div><dt class="text-gray-400 mb-0.5">Phone</dt><dd class="text-gray-900 font-medium">@info.Phone</dd></div>
            <div><dt class="text-gray-400 mb-0.5">Email</dt><dd class="text-gray-900 font-medium">@info.Email</dd></div>
            <div><dt class="text-gray-400 mb-0.5">Address</dt><dd class="text-gray-900 font-medium">@string.Join(", ", addressParts)</dd></div>
            <div><dt class="text-gray-400 mb-0.5">Date of Birth</dt><dd class="text-gray-900 font-medium">@(info.DateOfBirth?.ToString("MMM d, yyyy") ?? "—")</dd></div>
            <div><dt class="text-gray-400 mb-0.5">Employment</dt><dd class="text-gray-900 font-medium">@(info.Employment ?? "—")</dd></div>
            <div><dt class="text-gray-400 mb-0.5">Annual Income</dt><dd class="text-gray-900 font-medium">@(info.AnnualIncome is null ? "—" : info.AnnualIncome.Value.ToString("C0"))</dd></div>
            <div><dt class="text-gray-400 mb-0.5">Move-in Date</dt><dd class="text-gray-900 font-medium">@(info.DesiredMoveInDate?.ToString("MMM d, yyyy") ?? "—")</dd></div>
        </dl>
    </div>

    <div class="border border-gray-200 rounded-xl overflow-hidden">
        <div class="px-5 py-3 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
            <h3 class="text-sm font-bold text-ink">Residence History</h3>
            @if (Model.IsEditable)
            {
                <a asp-action="Wizard" asp-route-id="@Model.ApplicationId" asp-route-step="@WizardStep.ResidenceHistory"
                   class="text-xs font-semibold text-brand-600 hover:text-brand-700">Edit</a>
            }
        </div>
        @if (Model.Residences.Count == 0)
        {
            <p class="px-5 py-4 text-sm text-gray-400">No prior residences.</p>
        }
        else
        {
            <table class="w-full text-xs">
                <thead>
                    <tr class="bg-white border-b border-gray-100">
                        <th class="text-left px-5 py-2 font-semibold text-gray-500">Dates</th>
                        <th class="text-left px-5 py-2 font-semibold text-gray-500">Address</th>
                        <th class="text-left px-5 py-2 font-semibold text-gray-500">Landlord</th>
                        <th class="text-left px-5 py-2 font-semibold text-gray-500">Rent</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Residences)
                    {
                        <tr class="border-b border-gray-100 last:border-0">
                            <td class="px-5 py-2.5 text-gray-700">@r.MoveInDate.ToString("MMM yyyy") &ndash; @(r.MoveOutDate?.ToString("MMM yyyy") ?? "Present")</td>
                            <td class="px-5 py-2.5 text-gray-700">@r.AddressLine1, @r.City, @r.State</td>
                            <td class="px-5 py-2.5 text-gray-700">@r.LandlordName</td>
                            <td class="px-5 py-2.5 text-gray-700">@(r.MonthlyRent is null ? "—" : r.MonthlyRent.Value.ToString("C0"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="border border-gray-200 rounded-xl overflow-hidden px-5 py-4" id="coApplicantsRegion">
        @await Component.InvokeAsync("CoApplicantsSection", new { applicationId = Model.ApplicationId, isEditable = Model.IsEditable })
    </div>

</div>
