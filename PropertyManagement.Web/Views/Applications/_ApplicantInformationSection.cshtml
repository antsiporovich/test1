@model PropertyManagement.Web.Models.ApplicantInfoSectionViewModel

<input type="hidden" asp-for="RowVersion" />

<div class="space-y-5">
    <div class="grid sm:grid-cols-2 gap-5">
        <div>
            <label asp-for="FullName" class="block text-sm font-medium text-gray-700 mb-1.5">Full Name <span class="text-red-500">*</span></label>
            <input asp-for="FullName" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors" />
            <span asp-validation-for="FullName" class="text-xs text-red-500 mt-1 block"></span>
        </div>
        <div>
            <label asp-for="Phone" class="block text-sm font-medium text-gray-700 mb-1.5">Phone <span class="text-red-500">*</span></label>
            <input asp-for="Phone" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors" />
            <span asp-validation-for="Phone" class="text-xs text-red-500 mt-1 block"></span>
        </div>
    </div>

    <div>
        <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1.5">Email <span class="text-red-500">*</span></label>
        <input asp-for="Email" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors" />
        <span asp-validation-for="Email" class="text-xs text-red-500 mt-1 block"></span>
    </div>

    <div>
        <label asp-for="AddressLine1" class="block text-sm font-medium text-gray-700 mb-1.5">Current Address <span class="text-red-500">*</span></label>
        <input asp-for="AddressLine1" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors" />
        <span asp-validation-for="AddressLine1" class="text-xs text-red-500 mt-1 block"></span>
    </div>

    <div>
        <label asp-for="AddressLine2" class="block text-sm font-medium text-gray-700 mb-1.5">Address Line 2</label>
        <input asp-for="AddressLine2" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors" />
        <span asp-validation-for="AddressLine2" class="text-xs text-red-500 mt-1 block"></span>
    </div>

    <div class="grid sm:grid-cols-3 gap-5">
        <div>
            <label asp-for="City" class="block text-sm font-medium text-gray-700 mb-1.5">City <span class="text-red-500">*</span></label>
            <input asp-for="City" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors" />
            <span asp-validation-for="City" class="text-xs text-red-500 mt-1 block"></span>
        </div>
        <div>
            <label asp-for="State" class="block text-sm font-medium text-gray-700 mb-1.5">State <span class="text-red-500">*</span></label>
            <input asp-for="State" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors" />
            <span asp-validation-for="State" class="text-xs text-red-500 mt-1 block"></span>
        </div>
        <div>
            <label asp-for="ZipCode" class="block text-sm font-medium text-gray-700 mb-1.5">ZIP Code <span class="text-red-500">*</span></label>
            <input asp-for="ZipCode" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors" />
            <span asp-validation-for="ZipCode" class="text-xs text-red-500 mt-1 block"></span>
        </div>
    </div>
</div>
