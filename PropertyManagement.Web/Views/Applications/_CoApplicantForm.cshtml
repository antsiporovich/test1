@model PropertyManagement.Web.Models.AddApplicantFormViewModel

<div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
    <h5 class="text-base font-bold text-ink">Add Co-Applicant</h5>
    <button type="button" class="text-gray-400 hover:text-gray-600 transition-colors" data-bs-dismiss="modal" aria-label="Close">
        <i data-lucide="x" class="w-5 h-5" aria-hidden="true"></i>
    </button>
</div>
<form method="post" action="@Url.Action("AddApplicant", "Applications", new { applicationId = Model.ApplicationId })">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ApplicationId" />
    <div class="px-6 py-5">
        <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 bg-red-50 border border-red-200 text-red-700 rounded-xl text-sm empty:hidden" role="alert"></div>
        <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1.5">Applicant&rsquo;s Email</label>
        <input asp-for="Email" placeholder="name@example.com" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-colors" />
        <span asp-validation-for="Email" class="text-xs text-red-500 mt-1 block"></span>
        <p class="text-xs text-gray-400 mt-1.5">Must already be a registered Applicant account.</p>
    </div>
    <div class="flex justify-end gap-3 px-6 py-4 border-t border-gray-100 bg-gray-50/60">
        <button type="button" class="px-4 py-2 border border-gray-200 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-xl transition-colors" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-xl transition-colors shadow-sm">Add</button>
    </div>
</form>
