@model List<PropertyManagement.Web.Models.ApplicationListRowViewModel>

@if (Model.Count == 0)
{
    <p class="text-muted">No applications found.</p>
}
else
{
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                @if (User.IsInRole("PropertyManager"))
                {
                    <th>Applicant</th>
                }
                <th>Property / Unit</th>
                <th>Status</th>
                <th>Last updated</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    @if (User.IsInRole("PropertyManager"))
                    {
                        <td>@(row.ApplicantName ?? "—")</td>
                    }
                    <td>@row.PropertyName — Unit @row.UnitNumber</td>
                    <td><span class="badge text-bg-secondary">@row.Status</span></td>
                    <td>@row.LastUpdatedAtUtc.ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>
}
