@model List<PropertyManagement.Web.Models.ApplicationListRowViewModel>
@{
    var isApplicant = User.IsInRole("Applicant");
}

@if (Model.Count == 0)
{
    <p class="text-muted">No applications found.</p>
}
else
{
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                @if (User.IsInRole("PropertyManager"))
                {
                    <th>Applicant</th>
                }
                <th>Property / Unit</th>
                <th>Status</th>
                <th>Last updated</th>
                @if (isApplicant)
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    @if (User.IsInRole("PropertyManager"))
                    {
                        <td>@(row.ApplicantName ?? "—")</td>
                    }
                    <td>
                        @if (isApplicant)
                        {
                            <a asp-controller="Applications" asp-action="Wizard" asp-route-id="@row.Id">@row.PropertyName — Unit @row.UnitNumber</a>
                        }
                        else
                        {
                            <text>@row.PropertyName — Unit @row.UnitNumber</text>
                        }
                    </td>
                    <td><span class="badge text-bg-secondary">@row.Status</span></td>
                    <td>@row.LastUpdatedAtUtc.ToString("g")</td>
                    @if (isApplicant)
                    {
                        <td class="text-end">
                            @if (row.IsWithdrawable)
                            {
                                <form asp-controller="Applications" asp-action="Withdraw" asp-route-id="@row.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary"
                                            onclick="return confirm('Withdraw this application?');">
                                        Withdraw
                                    </button>
                                </form>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
