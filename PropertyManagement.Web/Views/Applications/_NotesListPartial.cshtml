@model IEnumerable<PropertyManagement.Web.Models.NoteRowViewModel>
@* NOTES-1/NOTES-2: PM-only notes list. *@

@if (!Model.Any())
{
    <p class="py-6 text-sm text-gray-400 text-center">No internal notes yet.</p>
}
else
{
    <ul class="divide-y divide-gray-100 py-2">
        @foreach (var note in Model)
        {
            <li class="py-3 first:pt-2 last:pb-2">
                <div class="flex items-start justify-between gap-3">
                    <p class="text-sm text-gray-800 whitespace-pre-wrap flex-1">@note.Body</p>
                    <button type="button" class="shrink-0 text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors"
                            data-ajax-modal-url="@Url.Action("EditNoteForm", "Applications", new { id = note.ApplicationId, noteId = note.Id })">
                        Edit
                    </button>
                </div>
                <p class="text-[11px] text-gray-400 mt-1.5">
                    @note.AuthorName &middot; @note.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                </p>
            </li>
        }
    </ul>
}
