@model IEnumerable<PropertyManagement.Web.Models.NoteRowViewModel>
@* NOTES-1/NOTES-2: PM-only notes list.
   This partial is served ONLY from PM-authorized controller actions — it is
   never included in any Applicant-facing view model or response. *@

@if (!Model.Any())
{
    <p class="text-sm text-gray-400">No notes yet.</p>
}
else
{
    <ul class="space-y-4">
        @foreach (var note in Model)
        {
            <li class="pb-4 border-b border-gray-50 last:border-0 last:pb-0">
                <div class="flex items-start justify-between gap-3">
                    <p class="text-sm text-gray-800 whitespace-pre-wrap flex-1">@note.Body</p>
                    <button type="button" class="shrink-0 text-xs font-medium text-gray-500 hover:text-gray-800 transition-colors"
                            data-ajax-modal-url="@Url.Action("EditNoteForm", "Applications", new { id = note.ApplicationId, noteId = note.Id })">
                        Edit
                    </button>
                </div>
                <p class="text-xs text-gray-400 mt-1.5">
                    @note.AuthorName &middot; @note.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                </p>
            </li>
        }
    </ul>
}
