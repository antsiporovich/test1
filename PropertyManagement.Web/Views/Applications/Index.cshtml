@model PropertyManagement.Web.Models.ApplicationListFilterViewModel
@using PropertyManagement.Web.Models
@{
    ViewData["Title"] = "Applications";
    var isApplicant = User.IsInRole("Applicant");

    var columns = new List<GridColumn>();
    if (!isApplicant)
    {
        columns.Add(new GridColumn("applicant", "Applicant"));
    }
    columns.Add(new GridColumn("property", "Property / Unit"));
    columns.Add(new GridColumn("status", "Status"));
    columns.Add(new GridColumn("updated", "Last updated", Type: "date"));

    var fixedParams = new Dictionary<string, string>();
    if (Model.Status is not null)
    {
        fixedParams["status"] = Model.Status.ToString()!;
    }
    if (Model.PropertyId is not null)
    {
        fixedParams["propertyId"] = Model.PropertyId.ToString()!;
    }

    // A non-numeric placeholder here would fail the {id:int} route constraint during
    // generation and silently fall back to the conventional /Applications/Wizard/{id}
    // route instead of the real attribute-routed /Applications/{id} — use a valid int
    // (0) and trim the trailing segment instead of substituting into it.
    string? rowUrlTemplate = null;
    if (isApplicant)
    {
        var sampleUrl = Url.Action("Wizard", "Applications", new { id = 0 })!;
        rowUrlTemplate = sampleUrl[..sampleUrl.LastIndexOf('/')] + "/{id}";
    }

    var gridVm = new GridViewModel
    {
        ApiEndpoint = Url.Content("~/api/applications"),
        Columns = columns,
        PageSize = 5, // small enough that the 10 seeded applications actually demonstrate paging
        FixedParams = fixedParams,
        RowUrlTemplate = rowUrlTemplate,
    };
}

<h1>Applications</h1>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}

@if (!isApplicant && Model.QueueRows is { Count: > 0 })
{
    <h2 class="h5">Review Queue</h2>
    <table class="table table-sm align-middle mb-4">
        <thead>
            <tr>
                <th>Property / Unit</th>
                <th>Status</th>
                <th>Claimed by</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.QueueRows)
            {
                <tr>
                    <td>@row.PropertyUnit</td>
                    <td>@row.Status</td>
                    <td>@row.ClaimedByName</td>
                    <td class="text-end">
                        @if (row.Status == ApplicationStatus.Submitted)
                        {
                            <form asp-action="Claim" asp-route-id="@row.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-primary">Claim</button>
                            </form>
                        }
                        else if (row.IsClaimedByMe)
                        {
                            <form asp-action="Release" asp-route-id="@row.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Release</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select asp-for="Status" asp-items="Model.StatusOptions" class="form-select">
            <option value="">All statuses</option>
        </select>
    </div>
    <div class="col-auto">
        <select asp-for="PropertyId" asp-items="Model.PropertyOptions" class="form-select">
            <option value="">All properties</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Filter</button>
    </div>
</form>

@await Component.InvokeAsync("Grid", new { model = gridVm })
