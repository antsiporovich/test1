@model PropertyManagement.Web.Models.ApplicationListFilterViewModel
@using PropertyManagement.Web.Models
@{
    ViewData["Title"] = "Applications";
    var isApplicant = User.IsInRole("Applicant");

    var columns = new List<GridColumn>();
    if (isApplicant)
    {
        columns.Add(new GridColumn("property", "Property / Unit", Sortable: true, Type: "appproperty", Width: "42%"));
        columns.Add(new GridColumn("status", "Status", Sortable: true, Type: "status", Width: "14%"));
        columns.Add(new GridColumn("updated", "Last Updated", Sortable: true, Type: "dateline", Width: "16%"));
    }
    else
    {
        columns.Add(new GridColumn("applicant", "Applicant", Sortable: false, Type: "twoline"));
        columns.Add(new GridColumn("property", "Property / Unit", Sortable: true, Type: "twoline"));
        columns.Add(new GridColumn("status", "Status", Sortable: true, Type: "status"));
        columns.Add(new GridColumn("updated", "Last Updated", Sortable: true, Type: "dateline"));
    }

    var fixedParams = new Dictionary<string, string>();
    if (Model.Status is not null)
    {
        fixedParams["status"] = Model.Status.ToString()!;
    }
    if (Model.PropertyId is not null)
    {
        fixedParams["propertyId"] = Model.PropertyId.ToString()!;
    }

    string? rowUrlTemplate;
    if (isApplicant)
    {
        var sampleUrl = Url.Action("Wizard", "Applications", new { id = 0 })!;
        rowUrlTemplate = sampleUrl[..sampleUrl.LastIndexOf('/')] + "/{id}";
    }
    else
    {
        var sampleUrl = Url.Action("Detail", "Applications", new { id = 0 })!;
        rowUrlTemplate = sampleUrl.Replace("/0/", "/{id}/");
    }

    var gridVm = new GridViewModel
    {
        ApiEndpoint = Url.Content("~/api/applications"),
        Columns = columns,
        PageSize = isApplicant ? 5 : 6,
        FixedParams = fixedParams,
        RowUrlTemplate = rowUrlTemplate,
        RowActionLabel = "View",
        ShowRowOverflowMenu = isApplicant,
        ActionColumnWidth = isApplicant ? "28%" : null,
        ItemLabel = "applications",
        SearchInputId = isApplicant ? null : "applicantSearchInput",
    };
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 @(isApplicant ? "" : "space-y-4")">

        @if (isApplicant)
        {
            <div class="flex flex-wrap items-start justify-between gap-6 mb-6">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1">Applications</p>
                    <h1 class="text-3xl font-extrabold text-ink mb-1">My Applications</h1>
                    <p class="text-sm text-muted max-w-lg leading-relaxed">
                        View and manage your rental applications. You can check the status, view details, or continue
                        an application at any time.
                    </p>
                </div>
                <div class="hidden lg:block relative bg-[#f7fbfd] border border-gray-200 rounded-xl w-[420px] h-[150px] overflow-hidden flex-shrink-0">
                    <img src="~/images/banner-building.png" alt="" class="absolute inset-0 w-full h-full object-cover" aria-hidden="true" />
                    <div class="absolute inset-0 flex items-center px-6">
                        <div>
                            <p class="text-sm font-semibold text-ink leading-snug">A better<br>place to call home</p>
                            <span class="block w-8 h-[3px] bg-brand-600 rounded-full mt-2"></span>
                        </div>
                    </div>
                </div>
            </div>

            <form method="get" class="flex flex-wrap items-end gap-3 mb-6">
                <div>
                    <label asp-for="Status" class="block text-xs font-semibold text-gray-500 mb-1.5">Status</label>
                    <select asp-for="Status" asp-items="Model.StatusOptions"
                            class="w-48 px-3.5 py-2 border border-gray-300 rounded-md text-sm text-gray-700 bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600">
                        <option value="">All Statuses</option>
                    </select>
                </div>
                <div>
                    <label asp-for="PropertyId" class="block text-xs font-semibold text-gray-500 mb-1.5">Property</label>
                    <select asp-for="PropertyId" asp-items="Model.PropertyOptions"
                            class="w-48 px-3.5 py-2 border border-gray-300 rounded-md text-sm text-gray-700 bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600">
                        <option value="">All Properties</option>
                    </select>
                </div>
                <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-md transition-colors">
                    <i data-lucide="sliders-horizontal" class="w-4 h-4"></i>
                    Filter
                </button>
            </form>
        }
        else
        {
            <div>
                <h1 class="text-3xl font-extrabold text-ink mb-1">Applications</h1>
                <p class="text-sm text-muted">Review and manage rental applications for your properties.</p>
            </div>
        }

        @if (TempData["Error"] is string error)
        {
            <div class="mb-5 flex items-center gap-3 px-4 py-3 bg-amber-50 border border-amber-200 text-amber-800 rounded-xl text-sm" role="alert">
                @error
            </div>
        }

        @if (!isApplicant && Model.QueueRows is { Count: > 0 })
        {
            <div class="border border-gray-200 rounded-xl overflow-hidden">
                <div class="px-6 py-3.5 border-b border-gray-200">
                    <h2 class="text-base font-bold text-ink">Review Queue</h2>
                    <p class="text-sm text-muted mt-0.5">Applications waiting to be claimed or reviewed by your team.</p>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-xs">
                        <thead>
                            <tr class="bg-gray-50 border-b border-gray-200">
                                <th class="text-left px-6 py-2.5 text-xs font-semibold text-gray-500">Property / Unit</th>
                                <th class="text-left px-6 py-2.5 text-xs font-semibold text-gray-500">Status</th>
                                <th class="text-left px-6 py-2.5 text-xs font-semibold text-gray-500">Claimed By</th>
                                <th class="text-right px-6 py-2.5 text-xs font-semibold text-gray-500">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.QueueRows)
                            {
                                var pu = row.PropertyUnit.Split(" — ");
                                <tr class="border-b border-gray-100 last:border-0 hover:bg-gray-50/70 transition-colors">
                                    <td class="px-6 py-2.5">
                                        <p class="text-gray-900 font-medium text-sm">@pu[0]</p>
                                        @if (pu.Length > 1)
                                        {
                                            <p class="text-[11px] text-gray-400 mt-0.5">@string.Join(" — ", pu[1..])</p>
                                        }
                                    </td>
                                    <td class="px-6 py-2.5">
                                        <partial name="_StatusBadge" model="@row.Status.ToString()" />
                                    </td>
                                    <td class="px-6 py-2.5 @(string.IsNullOrEmpty(row.ClaimedByName) ? "text-gray-400" : "text-gray-700")">
                                        @(row.ClaimedByName ?? "Unclaimed")
                                    </td>
                                    <td class="px-6 py-2.5 text-right whitespace-nowrap space-x-2">
                                        @if (row.Status == ApplicationStatus.Submitted)
                                        {
                                            <form asp-action="Claim" asp-route-id="@row.Id" method="post" class="inline">
                                                <button type="submit" class="inline-flex items-center justify-center w-[75px] py-1.5 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-md transition-colors">Claim</button>
                                            </form>
                                            <button type="button" class="inline-flex items-center justify-center w-[75px] py-1.5 border border-gray-300 text-gray-700 hover:bg-gray-50 text-xs font-semibold rounded-md transition-colors"
                                                    data-ajax-modal-url="@Url.Action("ReviewForm", new { id = row.Id })">Review</button>
                                        }
                                        else if (row.IsClaimedByMe)
                                        {
                                            <form asp-action="Release" asp-route-id="@row.Id" method="post" class="inline">
                                                <button type="submit" class="inline-flex items-center justify-center w-[75px] py-1.5 border border-gray-300 text-gray-700 hover:bg-gray-50 text-xs font-semibold rounded-md transition-colors">Release</button>
                                            </form>
                                            <button type="button" class="inline-flex items-center justify-center w-[75px] py-1.5 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-md transition-colors"
                                                    data-ajax-modal-url="@Url.Action("ReviewForm", new { id = row.Id })">Review</button>
                                        }
                                        else
                                        {
                                            <a asp-action="Detail" asp-route-id="@row.Id" class="inline-flex items-center justify-center w-[75px] py-1.5 border border-gray-300 text-gray-700 hover:bg-gray-50 text-xs font-semibold rounded-md transition-colors">View</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (!isApplicant)
        {
            <div class="border border-gray-200 rounded-xl px-6 py-3.5">
                <form method="get" class="flex flex-wrap items-end gap-3">
                    <div>
                        <label asp-for="Status" class="block text-xs font-semibold text-gray-500 mb-1.5">Status</label>
                        <select asp-for="Status" asp-items="Model.StatusOptions" onchange="this.form.submit()"
                                class="w-48 px-3.5 py-2 border border-gray-300 rounded-md text-sm text-gray-700 bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600">
                            <option value="">All Statuses</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="PropertyId" class="block text-xs font-semibold text-gray-500 mb-1.5">Property</label>
                        <select asp-for="PropertyId" asp-items="Model.PropertyOptions" onchange="this.form.submit()"
                                class="w-48 px-3.5 py-2 border border-gray-300 rounded-md text-sm text-gray-700 bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600">
                            <option value="">All Properties</option>
                        </select>
                    </div>
                    <a asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2 border border-gray-300 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-50 ml-auto transition-colors">
                        <i data-lucide="sliders-horizontal" class="w-4 h-4"></i>
                        Clear Filters
                    </a>
                </form>
            </div>

            <div class="border border-gray-200 rounded-xl overflow-hidden">
                <div class="px-6 py-3.5 border-b border-gray-200 flex flex-wrap items-start justify-between gap-4">
                    <div>
                        <h2 class="text-base font-bold text-ink">All Applications</h2>
                        <p class="text-sm text-muted mt-0.5">A list of all applications for your properties.</p>
                    </div>
                    <div class="relative">
                        <i data-lucide="search" class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
                        <input type="text" id="applicantSearchInput" placeholder="Search applicants…"
                               class="pl-9 pr-3.5 py-2 border border-gray-300 rounded-md text-sm text-gray-700 placeholder-gray-400 bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 w-56" />
                    </div>
                </div>
                @await Component.InvokeAsync("Grid", new { model = gridVm })
            </div>
        }
        else
        {
            <div class="border border-gray-200 rounded-xl overflow-hidden">
                @await Component.InvokeAsync("Grid", new { model = gridVm })
            </div>
        }

    </div>
</div>
