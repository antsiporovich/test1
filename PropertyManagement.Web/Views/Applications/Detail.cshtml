@model PropertyManagement.Web.Models.ApplicationDetailViewModel
@{
    ViewData["Title"] = "Application Detail";
}
@Html.AntiForgeryToken()

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <a asp-action="Index" asp-controller="Applications" class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-700 transition-colors mb-4">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        Back to Applications
    </a>

    <div class="flex items-start justify-between mb-1">
        <div class="flex items-center gap-3">
            <h1 class="text-2xl font-bold text-gray-900">@Model.ApplicantNames</h1>
            <partial name="_StatusBadge" model="Model.Status" />
        </div>
        @if (Model.CanReview)
        {
            <button type="button"
                    class="shrink-0 px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-xl transition-colors shadow-sm"
                    data-ajax-modal-url="@Url.Action("ReviewForm", "Applications", new { id = Model.Id })">
                Review Application
            </button>
        }
    </div>
    <p class="text-sm text-gray-500 mb-1">@Model.PropertyUnit</p>

    <div class="grid lg:grid-cols-2 gap-5 mt-6">

        @* ── Applicant Information ────────────────────────────────────────── *@
        <div class="bg-white border border-gray-100 rounded-2xl p-5">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-sm font-bold text-gray-900">Applicant Information</h2>
            </div>
            @if (Model.ApplicantInformation is null)
            {
                <p class="text-sm text-gray-400">Not yet completed.</p>
            }
            else
            {
                var info = Model.ApplicantInformation;
                <dl class="space-y-3 text-sm">
                    <div><dt class="text-gray-400 text-xs mb-0.5">Full Name</dt><dd class="text-gray-900">@info.FullName</dd></div>
                    <div><dt class="text-gray-400 text-xs mb-0.5">Email</dt><dd class="text-gray-900">@info.Email</dd></div>
                    <div><dt class="text-gray-400 text-xs mb-0.5">Phone</dt><dd class="text-gray-900">@info.Phone</dd></div>
                    <div>
                        <dt class="text-gray-400 text-xs mb-0.5">Address</dt>
                        <dd class="text-gray-900">
                            @info.AddressLine1@(string.IsNullOrEmpty(info.AddressLine2) ? "" : $", {info.AddressLine2}"), @info.City, @info.State @info.ZipCode
                        </dd>
                    </div>
                </dl>
            }
        </div>

        @* ── Residence History ────────────────────────────────────────────── *@
        <div class="bg-white border border-gray-100 rounded-2xl p-5">
            <h2 class="text-sm font-bold text-gray-900 mb-4">Residence History</h2>
            @if (!Model.Residences.Any())
            {
                <p class="text-sm text-gray-400">No prior residences listed.</p>
            }
            else
            {
                <ul class="space-y-4">
                    @foreach (var r in Model.Residences)
                    {
                        <li class="text-sm">
                            <p class="text-gray-900 font-medium">
                                @r.AddressLine1@(string.IsNullOrEmpty(r.AddressLine2) ? "" : $", {r.AddressLine2}"), @r.City, @r.State
                            </p>
                            <p class="text-gray-400 text-xs mt-0.5">
                                @r.MoveInDate.ToString("MMM yyyy") &ndash; @(r.MoveOutDate?.ToString("MMM yyyy") ?? "Present")
                                &middot; Landlord: @r.LandlordName (@r.LandlordPhone)
                            </p>
                        </li>
                    }
                </ul>
            }
        </div>

        @* ── PM Notes (NOTES-1/NOTES-2) — PM-only, never in applicant HTML ─── *@
        <div class="bg-white border border-gray-100 rounded-2xl p-5">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-sm font-bold text-gray-900">Internal Notes</h2>
                <button type="button" class="text-xs font-medium text-brand-600 hover:text-brand-700 transition-colors"
                        data-ajax-modal-url="@Url.Action("CreateNoteForm", "Applications", new { id = Model.Id })">
                    + Add Note
                </button>
            </div>
            <div id="notesListRegion">
                @await Html.PartialAsync("_NotesListPartial", Model.Notes)
            </div>
        </div>

        @* ── Status / Review History (REVIEW-5) ──────────────────────────── *@
        <div class="bg-white border border-gray-100 rounded-2xl p-5">
            <h2 class="text-sm font-bold text-gray-900 mb-4">Status &amp; Review History</h2>
            @if (!Model.StatusHistory.Any())
            {
                <p class="text-sm text-gray-400">No history entries yet.</p>
            }
            else
            {
                <ul class="space-y-4">
                    @foreach (var h in Model.StatusHistory)
                    {
                        <li class="flex gap-3">
                            <div class="w-2 h-2 rounded-full bg-brand-600 mt-1.5 shrink-0"></div>
                            <div class="text-sm">
                                <p class="text-gray-900">
                                    <span class="font-medium">@h.ResultingStatus</span>
                                    <span class="text-gray-400 text-xs ml-1">@h.Timestamp.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</span>
                                </p>
                                <p class="text-gray-500 text-xs mt-0.5">By @h.ActorName</p>
                                @if (!string.IsNullOrEmpty(h.Comment))
                                {
                                    <p class="text-gray-600 text-xs mt-1 italic">&ldquo;@h.Comment&rdquo;</p>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
